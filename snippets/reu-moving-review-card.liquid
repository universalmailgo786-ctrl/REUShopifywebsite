{%- comment -%}
  Review card for Trusted wellness reviews marquee.
  Accepts: block, section, show_sample, duplicate (optional)
{%- endcomment -%}
{%- liquid
  assign is_dup = duplicate | default: false
  assign card_id = 'ReuMrCard-' | append: section.id | append: '-' | append: block.id
  if is_dup
    assign card_id = card_id | append: '-dup'
  endif

  assign rating = block.settings.rating | default: 5
  if rating < 1
    assign rating = 1
  endif
  if rating > 5
    assign rating = 5
  endif

  assign avatar_asset = block.settings.avatar_asset | default: 'reu-avatar-01.svg'
  assign display_name = block.settings.name | default: 'REÚ customer'
-%}
<article
  class="reu-mr-card"
  id="{{ card_id }}"
  {% unless is_dup %}{{ block.shopify_attributes }}{% endunless %}
  {% if is_dup %}tabindex="-1"{% else %}tabindex="0"{% endif %}
>
  <header class="reu-mr-card__header">
    <span class="reu-mr-card__avatar" aria-hidden="true">
      {%- if block.settings.avatar != blank -%}
        {{
          block.settings.avatar
          | image_url: width: 120
          | image_tag:
            widths: '60,90,120',
            sizes: '48px',
            loading: 'lazy',
            alt: ''
        }}
      {%- else -%}
        <img
          src="{{ avatar_asset | asset_url }}"
          width="80"
          height="80"
          alt=""
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}
    </span>
    <span class="reu-mr-card__identity">
      <span class="reu-mr-card__name">{{ display_name }}</span>
      {%- if block.settings.date != blank -%}
        <span class="reu-mr-card__date">{{ block.settings.date }}</span>
      {%- elsif block.settings.role != blank -%}
        <span class="reu-mr-card__date">{{ block.settings.role }}</span>
      {%- endif -%}
    </span>
    {%- if show_sample -%}
      <span class="reu-mr-card__sample">Sample</span>
    {%- endif -%}
  </header>

  <div class="reu-mr-card__stars" aria-label="{{ rating }} out of 5 stars">
    {%- for i in (1..5) -%}
      <span class="reu-mr-card__star{% if i <= rating %} is-on{% endif %}" aria-hidden="true">
        {% render 'icon', name: 'star' %}
      </span>
    {%- endfor -%}
  </div>

  {%- if block.settings.title != blank -%}
    <h3 class="reu-mr-card__title">{{ block.settings.title }}</h3>
  {%- endif -%}

  {%- if block.settings.quote != blank -%}
    <p class="reu-mr-card__text">{{ block.settings.quote }}</p>
  {%- endif -%}

  {%- if block.settings.product != blank -%}
    <p class="reu-mr-card__product">
      {%- if block.settings.product_link != blank -%}
        <a href="{{ block.settings.product_link }}">{{ block.settings.product }}</a>
      {%- else -%}
        {{ block.settings.product }}
      {%- endif -%}
    </p>
  {%- endif -%}
</article>
