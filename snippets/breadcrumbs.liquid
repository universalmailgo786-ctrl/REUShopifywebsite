{%- comment -%} Accessible breadcrumbs with BreadcrumbList JSON-LD {%- endcomment -%}
{%- liquid
  assign crumb_collection = collection
  if request.page_type == 'product' and crumb_collection == blank and product.collections.size > 0
    assign crumb_collection = product.collections.first
  endif
-%}
<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.aria_label' | t }}">
  <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
  {%- case request.page_type -%}
    {%- when 'product' -%}
      {%- if crumb_collection != blank and crumb_collection.url != blank -%}
        <span class="breadcrumbs__sep" aria-hidden="true">/</span>
        <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a>
      {%- endif -%}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    {%- when 'collection' -%}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ collection.title }}</span>
    {%- when 'article' -%}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <a href="{{ blog.url }}">{{ blog.title }}</a>
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ article.title }}</span>
    {%- when 'page' -%}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title }}</span>
  {%- endcase -%}
</nav>
{%- if request.page_type == 'product' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumbs.home' | t | json }}, "item": {{ shop.url | append: routes.root_url | json }} }
    {%- if crumb_collection.url != blank %}, { "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": {{ shop.url | append: crumb_collection.url | json }} }{% endif %},
    { "@type": "ListItem", "position": {% if crumb_collection.url != blank %}3{% else %}2{% endif %}, "name": {{ product.title | json }} }
  ]
}
</script>
{%- endif -%}
