<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{%- endif -%}
    <title>{{ page_title }}</title>
    <style>
      :root{
        --color-green:{{ settings.color_green }};--color-rose:{{ settings.color_rose }};--color-mauve:{{ settings.color_mauve }};
        --color-cream:{{ settings.color_cream }};--color-blush:{{ settings.color_blush }};--color-lilac:{{ settings.color_lilac }};
        --color-bg:{{ settings.color_bg }};--color-surface:{{ settings.color_surface }};--color-text:{{ settings.color_text }};
        --color-text-muted:{{ settings.color_text | color_mix: settings.color_bg, 65 }};--color-heading:{{ settings.color_heading }};
        --color-on-green:{{ settings.color_cream }};--color-line:{{ settings.color_text | color_mix: settings.color_bg, 14 }};
        --font-display-stack:{{ settings.type_display_fallback }};--font-body-stack:{{ settings.type_body_fallback }};
      }
    </style>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main class="section bg-blush" style="min-height:100vh;display:grid;place-items:center">
      <div class="wrap wrap--narrow text-center">
        {{ content_for_layout }}
      </div>
    </main>
  </body>
</html>
