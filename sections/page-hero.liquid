{%- liquid
  assign has_media = false
  if section.settings.image != blank or section.settings.fallback_asset != blank
    assign has_media = true
  endif
  assign quiz_url = pages['find-your-reu'].url | default: pages.quiz.url | default: '/pages/find-your-reu'
  assign layout = section.settings.layout | default: 'image_right'
  assign is_banner = false
  if layout == 'banner' and has_media
    assign is_banner = true
  endif
  assign image_right = true
  if layout == 'image_left'
    assign image_right = false
  endif
-%}
<section class="page-hero{% if is_banner %} page-hero--banner{% elsif has_media %} page-hero--split{% else %} section page-hero--plain{% endif %} {% unless has_media %}{{ section.settings.bg_scheme }}{% endunless %}">
  {%- if is_banner -%}
    <div class="page-hero__banner">
      <div class="page-hero__banner-media" aria-hidden="true">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '900,1400,1800,2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: ''
          }}
        {%- else -%}
          <img
            src="{{ section.settings.fallback_asset | asset_url }}"
            width="1024"
            height="512"
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        {%- endif -%}
      </div>
      <div class="page-hero__banner-scrim" aria-hidden="true"></div>
      <div class="page-hero__banner-inner wrap">
        <div class="page-hero__banner-copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="page-hero__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}

          {%- if section.settings.use_h1 -%}
            <h1 class="page-hero__heading h1">{{ section.settings.heading | default: page.title }}</h1>
          {%- else -%}
            <h2 class="page-hero__heading h2">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="page-hero__body lede rte">{{ section.settings.body }}</div>
          {%- endif -%}

          {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
            <div class="page-hero__actions">
              {%- if section.settings.cta_label != blank -%}
                <a class="btn page-hero__btn" href="{{ section.settings.cta_link | default: quiz_url }}">
                  {{ section.settings.cta_label }}
                  <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span>
                </a>
              {%- endif -%}
              {%- if section.settings.cta2_label != blank -%}
                <a class="btn btn--secondary page-hero__btn-secondary" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2_label }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- elsif has_media -%}
    <div class="page-hero__grid{% unless image_right %} page-hero__grid--image-left{% endunless %}">
      <div class="page-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="page-hero__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.use_h1 -%}
          <h1 class="page-hero__heading h1">{{ section.settings.heading | default: page.title }}</h1>
        {%- else -%}
          <h2 class="page-hero__heading h2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="page-hero__body lede rte">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
          <div class="page-hero__actions">
            {%- if section.settings.cta_label != blank -%}
              <a class="btn" href="{{ section.settings.cta_link | default: quiz_url }}">
                {{ section.settings.cta_label }}
                <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span>
              </a>
            {%- endif -%}
            {%- if section.settings.cta2_label != blank -%}
              <a class="btn btn--secondary" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="page-hero__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: '700,1000,1400,2000',
              sizes: '(min-width: 900px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.heading | default: 'Our Story' | escape
          }}
        {%- else -%}
          <img
            src="{{ section.settings.fallback_asset | asset_url }}"
            width="1024"
            height="445"
            alt="{{ section.settings.heading | default: 'Our Story' | escape }}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="page-hero__inner wrap{% if section.settings.narrow %} wrap--narrow{% endif %}{% if section.settings.center %} page-hero__inner--center text-center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="page-hero__eyebrow eyebrow{% if section.settings.center %} text-center{% endif %}">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.use_h1 -%}
        <h1 class="page-hero__heading h1">{{ section.settings.heading | default: page.title }}</h1>
      {%- else -%}
        <h2 class="page-hero__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="page-hero__body lede rte"{% if section.settings.center %} style="margin-inline:auto;max-width:44rem"{% endif %}>{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
        <div class="page-hero__actions{% if section.settings.center %} page-hero__actions--center{% endif %}">
          {%- if section.settings.cta_label != blank -%}
            <a class="btn" href="{{ section.settings.cta_link | default: quiz_url }}">
              {{ section.settings.cta_label }}
              <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span>
            </a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="btn btn--secondary" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename", "info": "Theme asset filename, e.g. reu-our-story-hero.jpg" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "banner", "label": "Full-width background (text left)" },
      { "value": "image_right", "label": "Split — image right" },
      { "value": "image_left", "label": "Split — image left" }
    ], "default": "banner" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "checkbox", "id": "use_h1", "label": "Use H1 heading", "default": true },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" },
    { "type": "checkbox", "id": "center", "label": "Center (text-only layout)", "default": true },
    { "type": "checkbox", "id": "narrow", "label": "Narrow width (text-only layout)", "default": true },
    { "type": "select", "id": "bg_scheme", "label": "Background (text-only layout)", "options": [
      { "value": "bg-cream", "label": "Cream" },
      { "value": "bg-sage", "label": "Sage" }
    ], "default": "bg-cream" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
