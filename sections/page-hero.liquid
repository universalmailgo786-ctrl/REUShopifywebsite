<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap {% if section.settings.narrow %}wrap--narrow{% endif %} {% if section.settings.center %}text-center{% endif %}">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow{% if section.settings.center %} text-center{% endif %}">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.use_h1 -%}
      <h1 class="h1">{{ section.settings.heading | default: page.title }}</h1>
    {%- else -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}<div class="lede rte" style="margin-top:1rem{% if section.settings.center %};margin-inline:auto;max-width:44rem{% endif %}">{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
      <div style="display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.35rem{% if section.settings.center %};justify-content:center{% endif %}">
        {%- if section.settings.cta_label != blank -%}
          <a class="btn" href="{{ section.settings.cta_link | default: routes.root_url }}">{{ section.settings.cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn btn--secondary" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "checkbox", "id": "use_h1", "label": "Use H1 heading", "default": true },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" },
    { "type": "checkbox", "id": "center", "label": "Center", "default": true },
    { "type": "checkbox", "id": "narrow", "label": "Narrow width", "default": true },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-blush", "label": "Blush" }, { "value": "bg-lilac", "label": "Lilac" }
    ], "default": "bg-blush" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
