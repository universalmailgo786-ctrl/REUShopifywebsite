{%- liquid
  assign has_media = false
  if section.settings.image != blank or section.settings.fallback_asset != blank
    assign has_media = true
  endif
  assign quiz_url = pages['find-your-reu'].url | default: pages.quiz.url | default: '/pages/find-your-reu'
-%}
<section class="page-hero{% if has_media %} page-hero--media{% endif %} {% unless has_media %}{{ section.settings.bg_scheme }}{% endunless %}">
  {%- if has_media -%}
    <div class="page-hero__media" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            widths: '900,1400,2000,2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      {%- else -%}
        <img
          src="{{ section.settings.fallback_asset | asset_url }}"
          width="1024"
          height="445"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- endif -%}
    </div>
    <div class="page-hero__shade" aria-hidden="true"></div>
  {%- endif -%}

  <div class="page-hero__inner wrap{% if section.settings.narrow and has_media == false %} wrap--narrow{% endif %}{% if section.settings.center and has_media == false %} text-center{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="page-hero__eyebrow eyebrow{% if section.settings.center and has_media == false %} text-center{% endif %}">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.use_h1 -%}
      <h1 class="page-hero__heading h1">{{ section.settings.heading | default: page.title }}</h1>
    {%- else -%}
      <h2 class="page-hero__heading h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="page-hero__body lede rte"{% if section.settings.center and has_media == false %} style="margin-inline:auto;max-width:44rem"{% endif %}>{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
      <div class="page-hero__actions"{% if section.settings.center and has_media == false %} style="justify-content:center"{% endif %}>
        {%- if section.settings.cta_label != blank -%}
          <a class="btn{% if has_media %} btn--on-dark{% endif %}" href="{{ section.settings.cta_link | default: quiz_url }}">
            {{ section.settings.cta_label }}
            <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn btn--secondary{% if has_media %} btn--on-dark{% endif %}" href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Full-width background. Leave empty to use the fallback asset or a solid colour." },
    { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename", "info": "Theme asset filename, e.g. reu-our-story.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "checkbox", "id": "use_h1", "label": "Use H1 heading", "default": true },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" },
    { "type": "checkbox", "id": "center", "label": "Center (solid background only)", "default": true },
    { "type": "checkbox", "id": "narrow", "label": "Narrow width (solid background only)", "default": true },
    { "type": "select", "id": "bg_scheme", "label": "Background (when no image)", "options": [
      { "value": "", "label": "White" },
      { "value": "bg-cream", "label": "Cream" },
      { "value": "bg-blush", "label": "Blush" },
      { "value": "bg-lilac", "label": "Lilac" }
    ], "default": "bg-blush" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
