<section class="newsletter section" aria-labelledby="NewsletterHeading-{{ section.id }}">
  <div class="wrap">
    <div class="newsletter__layout">
      <div class="newsletter__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="newsletter__eyebrow">
            <span class="newsletter__sparkle" aria-hidden="true">{% render 'icon', name: 'sparkle' %}</span>
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        <h2 class="newsletter__heading" id="NewsletterHeading-{{ section.id }}">
          {%- if section.settings.heading_before != blank or section.settings.heading_accent != blank -%}
            {{ section.settings.heading_before }}
            {%- if section.settings.heading_accent != blank -%}
              <em class="newsletter__accent">{{ section.settings.heading_accent }}</em>
            {%- endif -%}
            {{ section.settings.heading_after }}
          {%- else -%}
            {{ section.settings.heading | newline_to_br }}
          {%- endif -%}
        </h2>

        {%- if section.settings.body != blank -%}
          <p class="newsletter__body">{{ section.settings.body }}</p>
        {%- endif -%}

        {%- form 'customer', class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <div class="form-message form-message--success" role="status">{{ 'general.newsletter.success' | t }}</div>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email</label>
          <div class="newsletter__field">
            <input
              class="newsletter__input"
              id="NewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.placeholder }}"
              required
              autocomplete="email"
            >
            <button class="newsletter__submit" type="submit">
              <span>{{ section.settings.button_label }}</span>
              <span class="newsletter__submit-icon" aria-hidden="true">{% render 'icon', name: 'arrow-up-right' %}</span>
            </button>
          </div>
        {%- endform -%}

        {%- if section.settings.consent != blank -%}
          <p class="newsletter__consent">
            {{ section.settings.consent }}
            {%- if section.settings.privacy_link != blank -%}
              {{ ' ' }}<a href="{{ section.settings.privacy_link }}">Privacy Policy</a>.
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>

      <div class="newsletter__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '600,900,1200,1600',
              sizes: '(min-width:900px) 46vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image_alt | default: section.settings.eyebrow | escape
          }}
        {%- else -%}
          <img
            src="{{ 'reu-newsletter-visual.jpg' | asset_url }}"
            width="1448"
            height="1086"
            alt="{{ section.settings.image_alt | default: 'REÚ packaging collection' | escape }}"
            loading="lazy"
            decoding="async"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the REÚ community" },
    { "type": "text", "id": "heading_before", "label": "Heading before accent", "default": "A " },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "better" },
    { "type": "text", "id": "heading_after", "label": "Heading after accent", "default": " routine starts here." },
    { "type": "textarea", "id": "heading", "label": "Fallback heading", "default": "A better routine\nstarts here." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join the REÚ community for launch updates, wellness guidance, new products, and thoughtful offers." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email..." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the List" },
    { "type": "textarea", "id": "consent", "label": "Consent copy", "default": "By subscribing, you agree to receive marketing emails from REÚ. You may unsubscribe at any time." },
    { "type": "url", "id": "privacy_link", "label": "Privacy Policy link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "REÚ packaging collection" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
