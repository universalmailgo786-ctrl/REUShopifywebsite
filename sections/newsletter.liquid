<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap wrap--narrow text-center">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}

    {%- form 'customer', id: 'newsletter-form', class: 'stack', novalidate: 'novalidate' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'general.newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-message form-message--error">{{ 'general.newsletter.error' | t }}</p>
      {%- endif -%}
      <div style="display:flex;gap:.5rem;max-width:26rem;margin:1.25rem auto 0">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter.label' | t }}</label>
        <input class="input" id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required autocomplete="email">
        <button class="btn" type="submit">{{ 'general.newsletter.button' | t }}</button>
      </div>
      {%- if section.settings.microcopy != blank -%}<p class="form-note" style="margin-top:.75rem">{{ section.settings.microcopy }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A better routine starts here" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join the REÚ community for launch updates, wellness guidance, new releases, and thoughtful offers." },
    { "type": "textarea", "id": "microcopy", "label": "Microcopy", "default": "By subscribing, you agree to receive marketing emails. You can unsubscribe at any time." },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "bg-lilac", "label": "Lilac" }, { "value": "bg-cream", "label": "Cream" }, { "value": "", "label": "White" }
    ], "default": "bg-lilac" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
