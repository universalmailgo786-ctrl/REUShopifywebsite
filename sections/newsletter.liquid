<section class="section">
  <div class="wrap">
    <div class="newsletter-split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | newline_to_br }}</h2>
        {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:1rem">{{ section.settings.body }}</p>{%- endif -%}
        {%- form 'customer', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <div class="form-message form-message--success" role="status">{{ 'general.newsletter.success' | t }}</div>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email</label>
          <input class="input" id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ section.settings.placeholder }}" required autocomplete="email">
          <button class="btn" type="submit">{{ section.settings.button_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></button>
        {%- endform -%}
        {%- if section.settings.consent != blank -%}
          <p class="form-note" style="margin-top:.85rem">
            {{ section.settings.consent }}
            {%- if section.settings.privacy_link != blank -%}
              {{ ' ' }}<a href="{{ section.settings.privacy_link }}">View our Privacy Policy</a>.
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>
      <div class="newsletter-split__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '600,900,1200', sizes: '(min-width:900px) 45vw, 100vw', loading: 'lazy', alt: section.settings.heading | escape }}
        {%- else -%}
          <img src="{{ 'reu-gummies-mixed-berry.jpg' | asset_url }}" width="2000" height="1333" alt="" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the REÚ community" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A better routine\nstarts here." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Join the REÚ community for launch updates, wellness guidance, new products, and thoughtful offers." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the List" },
    { "type": "textarea", "id": "consent", "label": "Consent copy", "default": "By subscribing, you agree to receive marketing emails from REÚ. You may unsubscribe at any time." },
    { "type": "url", "id": "privacy_link", "label": "Privacy Policy link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
