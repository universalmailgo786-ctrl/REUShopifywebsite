{%- liquid
  assign limit = section.settings.limit | default: 24
  assign accent = section.settings.heading_accent | default: 'feeling your best'
  assign bg = section.settings.background_image
  assign collection = section.settings.collection
  assign products = collections.all.products

  if products == blank or products.size == 0
    if collection != blank
      assign products = collection.products
    endif
  endif

  if products == blank or products.size == 0
    assign collection = collections['pouch-collection']
    assign products = collection.products
  endif

  if products == blank or products.size == 0
    assign collection = collections['sachet-collection']
    assign products = collection.products
  endif

  assign fallback_handles = 'collagen-mixed-berry-pouch,collagen-mixed-berry-sachet,hydration-electrolytes-lemon-lime-pouch,hydration-electrolytes-lemon-lime-sachet,hydration-electrolytes-watermelon-pouch,hydration-electrolytes-watermelon-sachet,hydration-electrolytes-coconut-pouch,hydration-electrolytes-coconut-sachet,greens-pineapple-pouch,greens-pineapple-sachet,daily-wellness-peach-mango-pouch,daily-wellness-peach-mango-sachet,gummies-mixed-berry-pouch,gummies-mixed-berry-sachet,weight-management-pink-lemonade-pouch,weight-management-pink-lemonade-sachet,premium-protein-chocolate-pouch,premium-protein-chocolate-sachet' | split: ','
  assign use_fallback = false
  if products == blank or products.size == 0
    assign use_fallback = true
  endif
-%}
<section
  class="everyday-wellness"
  data-wellness-carousel
  aria-labelledby="EverydayWellnessHeading-{{ section.id }}"
>
  <div class="everyday-wellness__media" aria-hidden="true">
    {%- if bg != blank -%}
      {{ bg
        | image_url: width: 2800
        | image_tag:
          widths: '900,1400,2000,2800',
          sizes: '100vw',
          loading: 'lazy',
          alt: ''
      }}
    {%- else -%}
      <img
        src="{{ 'reu-everyday-wellness-bg.jpg' | asset_url }}"
        width="2560"
        height="1105"
        alt=""
        loading="lazy"
        decoding="async"
      >
    {%- endif -%}
  </div>
  <div class="everyday-wellness__overlay" aria-hidden="true"></div>

  <div class="everyday-wellness__content wrap">
    <div class="everyday-wellness__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="everyday-wellness__eyebrow">
          {%- if section.settings.show_sparkle -%}
            <span class="everyday-wellness__sparkle" aria-hidden="true">{% render 'icon', name: 'sparkle' %}</span>
          {%- endif -%}
          <span>{{ section.settings.eyebrow }}</span>
        </p>
      {%- endif -%}
      <h2 class="everyday-wellness__heading" id="EverydayWellnessHeading-{{ section.id }}">
        {%- if section.settings.heading_before != blank -%}{{ section.settings.heading_before }}{%- endif -%}
        {%- if accent != blank -%}<em class="everyday-wellness__accent">{{ accent }}</em>{%- endif -%}
        {%- if section.settings.heading_after != blank -%}{{ section.settings.heading_after }}{%- endif -%}
      </h2>
    </div>

    <div class="everyday-wellness__carousel">
      <button
        type="button"
        class="everyday-wellness__nav everyday-wellness__nav--prev"
        data-wellness-prev
        aria-label="Previous products"
      >
        {% render 'icon', name: 'arrow-left' %}
      </button>

      <div class="everyday-wellness__track" data-wellness-track tabindex="0" role="list">
        {%- if use_fallback == false -%}
          {%- for product in products limit: limit -%}
            {%- if product != blank and product.title != blank -%}
              {% render 'everyday-wellness-card', product: product, button_label: section.settings.button_label %}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign shown = 0 -%}
          {%- for handle in fallback_handles -%}
            {%- if shown >= limit -%}{%- break -%}{%- endif -%}
            {%- assign product = all_products[handle] -%}
            {%- if product != blank and product.title != blank -%}
              {% render 'everyday-wellness-card', product: product, button_label: section.settings.button_label %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if shown == 0 -%}
            <div class="everyday-wellness__empty" role="listitem">
              <p>Publish products to the Online Store to show them here.</p>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <button
        type="button"
        class="everyday-wellness__nav everyday-wellness__nav--next"
        data-wellness-next
        aria-label="Next products"
      >
        {% render 'icon', name: 'arrow' %}
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Everyday wellness",
  "class": "section-everyday-wellness",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background lifestyle image"
    },
    {
      "type": "checkbox",
      "id": "show_sparkle",
      "label": "Show sparkle in eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Everyday wellness"
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading before accent",
      "default": "Discover products for "
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent phrase (italic)",
      "default": "feeling your best"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading after accent"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection",
      "info": "Leave blank to show all Online Store products."
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 50,
      "step": 1,
      "label": "Max products",
      "default": 24
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Product button label",
      "default": "Pre-Order"
    }
  ],
  "presets": [
    {
      "name": "Everyday wellness"
    }
  ]
}
{% endschema %}
