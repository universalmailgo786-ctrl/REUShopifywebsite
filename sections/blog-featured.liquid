{%- liquid
  assign blog = section.settings.blog
-%}
<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    {%- if blog.articles.size > 0 -%}
      <div class="snap-row">
        {%- for article in blog.articles limit: section.settings.limit -%}
          <article class="card">
            <a class="card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: widths: '300,500,700', sizes: '(min-width:750px) 30vw, 80vw', loading: 'lazy', alt: article.image.alt | default: article.title | escape }}
              {%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </a>
            <div class="card__body">
              <h3 class="h4"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              <p class="text-muted" style="margin-top:.4rem">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
              <a class="link-arrow" style="margin-top:.75rem" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }} {% render 'icon', name: 'arrow' %}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="text-muted">Choose a blog in the theme editor to feature articles.</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:1.75rem"><a class="btn btn--secondary" href="{{ blog.url | default: '#' }}">{{ section.settings.cta_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Journal articles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wellness education" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wellness, made clearer" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Practical reads to help you understand ingredients, build routines, and choose products with greater confidence." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "min": 2, "max": 6, "step": 1, "label": "Articles", "default": 3 },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Visit the Journal" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }
    ], "default": "bg-cream" }
  ],
  "presets": [{ "name": "Journal articles" }]
}
{% endschema %}
