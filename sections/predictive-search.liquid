{%- comment -%} Rendered via the Predictive Search API into the search drawer. {%- endcomment -%}
<div data-predictive-inner>
  {%- if predictive_search.performed -%}
    {%- if predictive_search.resources.products.size > 0 -%}
      <p class="eyebrow">Products</p>
      <div class="grid cols-2" style="margin-bottom:1rem">
        {%- for product in predictive_search.resources.products limit: 4 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if predictive_search.resources.articles.size > 0 -%}
      <p class="eyebrow">Journal</p>
      <ul class="stack">
        {%- for article in predictive_search.resources.articles limit: 3 -%}
          <li><a class="link-arrow" href="{{ article.url }}">{{ article.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if predictive_search.resources.products.size == 0 and predictive_search.resources.articles.size == 0 -%}
      <p class="text-muted">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>
{% schema %}
{ "name": "Predictive search" }
{% endschema %}
