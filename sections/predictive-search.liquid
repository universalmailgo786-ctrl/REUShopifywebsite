{%- comment -%} Rendered via the Predictive Search API into the search drawer. {%- endcomment -%}
<div data-predictive-inner>
  {%- if predictive_search.performed -%}
    {%- if predictive_search.resources.products.size > 0 -%}
      <div class="search-drawer__group">
        <p class="search-drawer__label">Products</p>
        <div class="search-drawer__list">
          {%- for product in predictive_search.resources.products limit: 8 -%}
            {% render 'search-result-card', product: product %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.articles.size > 0 -%}
      <div class="search-drawer__group">
        <p class="search-drawer__label">Journal</p>
        <ul class="search-drawer__articles">
          {%- for article in predictive_search.resources.articles limit: 4 -%}
            <li>
              <a class="search-drawer__article" href="{{ article.url }}">{{ article.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.pages.size > 0 -%}
      <div class="search-drawer__group">
        <p class="search-drawer__label">Pages</p>
        <ul class="search-drawer__articles">
          {%- for page in predictive_search.resources.pages limit: 4 -%}
            <li>
              <a class="search-drawer__article" href="{{ page.url }}">{{ page.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.products.size == 0 and predictive_search.resources.articles.size == 0 and predictive_search.resources.pages.size == 0 -%}
      <p class="search-drawer__empty">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}

    {%- if predictive_search.resources.products.size > 0 or predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
      <a class="search-drawer__view-all btn btn--secondary" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}">
        View all results
      </a>
    {%- endif -%}
  {%- endif -%}
</div>
{% schema %}
{ "name": "Predictive search" }
{% endschema %}
