<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="h1">{{ blog.title }}</h1>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem;max-width:44rem">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    {%- if blog.all_tags.size > 0 and section.settings.show_tags -%}
      <div class="active-filters">
        <a class="filter-chip" href="{{ blog.url }}" {% unless current_tags %}style="background:var(--color-green);color:#fff"{% endunless %}>All</a>
        {%- for tag in blog.all_tags -%}
          <a class="filter-chip" href="{{ blog.url }}/tagged/{{ tag | handle }}" {% if current_tags contains tag %}style="background:var(--color-green);color:#fff"{% endif %}>{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate blog.articles by 12 -%}
      <div class="grid cols-3" role="list">
        {%- for article in blog.articles -%}
          <article class="card" role="listitem">
            <a class="card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(min-width:750px) 30vw, 90vw', alt: article.image.alt | default: article.title | escape }}
              {%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </a>
            <div class="card__body">
              {%- if article.tags.size > 0 -%}<span class="badge">{{ article.tags.first }}</span>{%- endif -%}
              <h2 class="h4" style="margin-top:.5rem"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="text-muted" style="margin-top:.4rem">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              <a class="link-arrow" style="margin-top:.75rem" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }} {% render 'icon', name: 'arrow' %}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The REÚ Journal" },
    { "type": "textarea", "id": "body", "label": "Intro", "default": "Clear, practical guidance for building a wellness routine that feels informed, enjoyable, and genuinely yours." },
    { "type": "checkbox", "id": "show_tags", "label": "Show category tags", "default": true }
  ]
}
{% endschema %}
