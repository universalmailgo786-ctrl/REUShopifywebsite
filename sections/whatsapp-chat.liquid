{{ 'reu-whatsapp-chat.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_widget -%}
  {%- liquid
    assign phone = section.settings.phone_number | strip | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
    assign delay_ms = section.settings.display_delay | default: 5 | times: 1000
    assign prefill = section.settings.prefill_message | default: 'Hello! I need some help.'
    assign wa_href = blank
  -%}
  {%- if phone != blank -%}
    {%- capture wa_href -%}https://wa.me/{{ phone }}?text={{ prefill | url_encode }}{%- endcapture -%}
  {%- endif -%}

  <div
    id="ReuWhatsApp-{{ section.id }}"
    class="reu-wa reu-wa--d-{{ section.settings.desktop_position }} reu-wa--m-{{ section.settings.mobile_position }}"
    data-reu-whatsapp
    data-delay="{{ delay_ms }}"
    data-phone="{{ phone | escape }}"
    data-wa-url="{{ wa_href | escape }}"
    data-session-key="reu-wa-popup-shown"
  >
    <div
      class="reu-wa__panel"
      id="ReuWhatsAppPanel-{{ section.id }}"
      role="dialog"
      aria-modal="false"
      aria-labelledby="ReuWhatsAppTitle-{{ section.id }}"
      aria-describedby="ReuWhatsAppMsg-{{ section.id }}"
      hidden
      data-reu-wa-panel
    >
      <div class="reu-wa__panel-head">
        <span class="reu-wa__brand-icon" aria-hidden="true">
          {% render 'icon-whatsapp' %}
        </span>
        <div class="reu-wa__panel-copy">
          <p class="reu-wa__title" id="ReuWhatsAppTitle-{{ section.id }}">{{ section.settings.heading }}</p>
          <p class="reu-wa__message" id="ReuWhatsAppMsg-{{ section.id }}">{{ section.settings.welcome_message }}</p>
        </div>
        <button
          type="button"
          class="reu-wa__close"
          data-reu-wa-close
          aria-label="Close chat window"
        >
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="reu-wa__panel-actions">
        {%- if wa_href != blank -%}
          <a
            class="reu-wa__cta btn"
            href="{{ wa_href }}"
            target="_blank"
            rel="noopener noreferrer"
            data-reu-wa-start
          >
            <span class="reu-wa__cta-icon" aria-hidden="true">{% render 'icon-whatsapp' %}</span>
            {{ section.settings.button_text }}
          </a>
        {%- else -%}
          <button
            type="button"
            class="reu-wa__cta btn"
            data-reu-wa-start
            aria-disabled="true"
          >
            <span class="reu-wa__cta-icon" aria-hidden="true">{% render 'icon-whatsapp' %}</span>
            {{ section.settings.button_text }}
          </button>
        {%- endif -%}
      </div>
    </div>

    <button
      type="button"
      class="reu-wa__fab"
      data-reu-wa-fab
      aria-label="{{ section.settings.heading | default: 'Chat with us on WhatsApp' | escape }}"
      aria-controls="ReuWhatsAppPanel-{{ section.id }}"
      aria-expanded="false"
    >
      <span class="reu-wa__fab-icon" aria-hidden="true">{% render 'icon-whatsapp' %}</span>
    </button>
  </div>

  <script src="{{ 'reu-whatsapp-chat.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp chat",
  "tag": "section",
  "class": "section-reu-whatsapp",
  "settings": [
    { "type": "checkbox", "id": "enable_widget", "label": "Enable WhatsApp widget", "default": true },
    { "type": "header", "content": "WhatsApp number" },
    {
      "type": "text",
      "id": "phone_number",
      "label": "WhatsApp phone number",
      "info": "Complete international number with country code. Digits only — no spaces or + (example: 15551234567)."
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chat with us" },
    {
      "type": "textarea",
      "id": "welcome_message",
      "label": "Welcome message",
      "default": "Hi! How can we help you today? Send us a message on WhatsApp."
    },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Start Chat" },
    {
      "type": "textarea",
      "id": "prefill_message",
      "label": "Pre-filled WhatsApp message",
      "default": "Hello! I need some help."
    },
    { "type": "header", "content": "Behavior" },
    {
      "type": "range",
      "id": "display_delay",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Display delay",
      "default": 5,
      "info": "Automatic popup delay on first visit in a browser session."
    },
    {
      "type": "select",
      "id": "desktop_position",
      "label": "Desktop position",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "select",
      "id": "mobile_position",
      "label": "Mobile position",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "bottom-right"
    }
  ],
  "presets": [{ "name": "WhatsApp chat" }]
}
{% endschema %}
