<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap {% if section.settings.narrow %}wrap--narrow{% endif %}">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-bottom:1rem">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.content }}</div>
    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:1.5rem"><a class="btn" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add your content here.</p>" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow width", "default": true },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "bg-cream", "label": "Cream" }, { "value": "bg-sage", "label": "Sage" }
    ], "default": "bg-cream" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
