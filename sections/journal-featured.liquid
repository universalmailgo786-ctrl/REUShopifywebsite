{%- assign blog = blogs[section.settings.blog] -%}
<section class="section bg-sage">
  <div class="wrap">
    <div class="section-head section-head--row">
      <div class="section-head__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--secondary" href="{% if blog != blank %}{{ blog.url }}{% else %}{{ section.settings.cta_link | default: routes.root_url }}{% endif %}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    <div class="journal-grid">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.limit -%}
          <article class="journal-card">
            <a class="journal-card__media" href="{{ article.url }}">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width:900px) 30vw, 100vw', loading: 'lazy', alt: article.title | escape }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            {%- if article.excerpt != blank -%}<p class="text-muted">{{ article.excerpt | strip_html | truncate: 120 }}</p>{%- endif -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <article class="journal-card" {{ block.shopify_attributes }}>
            <div class="journal-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <h3>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title }}</a>{% else %}{{ block.settings.title }}{% endif %}</h3>
            <p class="text-muted">{{ block.settings.text }}</p>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Journal featured",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The REÚ Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wellness, made clearer." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Practical guidance to help you understand ingredients, build better routines, and choose products with greater confidence." },
    { "type": "text", "id": "blog", "label": "Blog handle", "default": "news" },
    { "type": "range", "id": "limit", "min": 2, "max": 6, "step": 1, "default": 3, "label": "Articles" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Visit the Journal" },
    { "type": "url", "id": "cta_link", "label": "CTA fallback link" }
  ],
  "blocks": [
    { "type": "card", "name": "Launch card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "How to Build a Wellness Routine You Can Actually Keep" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Simple habits work best when they fit the life you already live." },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{
    "name": "Journal featured",
    "blocks": [
      { "type": "card", "settings": { "title": "How to Build a Wellness Routine You Can Actually Keep", "text": "Simple habits work best when they fit the life you already live." } },
      { "type": "card", "settings": { "title": "Electrolytes Explained", "text": "A straightforward introduction to hydration support and when it may fit your routine." } },
      { "type": "card", "settings": { "title": "Pouch or Sachet?", "text": "Choose the format that works best for home, travel, or both." } }
    ]
  }]
}
{% endschema %}
