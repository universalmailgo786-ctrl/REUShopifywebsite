<section class="shop-collections section" aria-labelledby="ShopCollectionsHeading-{{ section.id }}">
  <div class="wrap">
    <header class="shop-collections__head">
      <h2 class="shop-collections__title" id="ShopCollectionsHeading-{{ section.id }}">
        {{ section.settings.heading | default: 'Shop By Collection' }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="shop-collections__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    <div class="shop-collections__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign href = blank
          if col != blank and col.url != blank
            assign href = col.url
          elsif block.settings.link != blank
            assign href = block.settings.link
          else
            assign href = routes.all_products_collection_url
          endif
          assign tone = block.settings.tone | default: 'cream'
          assign fallback = block.settings.fallback_asset | default: 'reu-collection-pouch.jpg'
        -%}
        <article class="shop-collection-card shop-collection-card--{{ tone }}" {{ block.shopify_attributes }}>
          <div class="shop-collection-card__copy">
            {%- if block.settings.title != blank -%}
              <h3 class="shop-collection-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            <span class="shop-collection-card__rule" aria-hidden="true"></span>
            {%- if block.settings.kicker != blank -%}
              <p class="shop-collection-card__kicker">{{ block.settings.kicker }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="shop-collection-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
            <a class="btn btn--on-dark shop-collection-card__btn" href="{{ href }}">
              <span>{{ block.settings.cta | default: 'Shop now' }}</span>
              <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span>
            </a>
          </div>
          <div class="shop-collection-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image
                | image_url: width: 1400
                | image_tag:
                  widths: '480,700,1000,1400',
                  sizes: '(min-width: 990px) 24vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.title
              }}
            {%- else -%}
              <img
                src="{{ fallback | asset_url }}"
                width="1000"
                height="1250"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by collection",
  "tag": "section",
  "class": "section-shop-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "One routine. Two ways to enjoy it."
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "select",
          "id": "tone",
          "label": "Card background",
          "options": [
            { "value": "cream", "label": "Warm Cream" },
            { "value": "blush", "label": "Soft Blush" },
            { "value": "lilac", "label": "Pale Lilac" }
          ],
          "default": "cream"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pouch Collection"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Your everyday staple"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Full-size favourites for a consistent at-home routine."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button label",
          "default": "Shop Pouches"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback asset filename",
          "default": "reu-collection-pouch.jpg"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Shop by collection",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "tone": "cream",
            "title": "Pouch Collection",
            "kicker": "Your everyday staple",
            "text": "Full-size favourites for a consistent at-home routine.",
            "cta": "Shop Pouches",
            "fallback_asset": "reu-collection-pouch.jpg"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "tone": "blush",
            "title": "Sachet Collection",
            "kicker": "Wellness, wherever you go",
            "text": "Single-serve convenience for work, travel, gym bags, and busy days.",
            "cta": "Shop Sachets",
            "fallback_asset": "reu-collection-sachet.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
