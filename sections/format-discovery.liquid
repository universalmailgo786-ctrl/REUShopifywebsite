<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    <div class="grid cols-2">
      {%- for block in section.blocks -%}
        <div class="format-card" {{ block.shopify_attributes }}>
          <div class="format-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width:750px) 45vw, 100vw', loading: 'lazy', alt: block.settings.title | escape }}
            {%- elsif block.settings.fallback_asset != blank -%}
              <img src="{{ block.settings.fallback_asset | asset_url }}" width="1800" height="1200" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="format-card__body">
            <h3 class="h3">{{ block.settings.title }}</h3>
            <p class="text-muted">{{ block.settings.text }}</p>
            <div style="margin-top:auto;padding-top:.75rem"><a class="btn btn--secondary" href="{{ block.settings.link | default: '#' }}">{{ block.settings.cta }}</a></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <div class="text-center" style="margin-top:1.75rem"><a class="link-arrow" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }} {% render 'icon', name: 'arrow' %}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Format discovery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "One routine. Two ways to enjoy it." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose the format that fits your day" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Keep your daily favourites at home in a full-size pouch, or take the same REÚ experience with you in convenient single-serve sachets." },
    { "type": "text", "id": "cta_label", "label": "Compare CTA", "default": "Compare Formats" },
    { "type": "url", "id": "cta_link", "label": "Compare link" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }
    ], "default": "" }
  ],
  "blocks": [
    { "type": "format", "name": "Format card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename" },
      { "type": "text", "id": "title", "label": "Title", "default": "Pouches" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Keep your favourite formula ready for a consistent at-home routine." },
      { "type": "text", "id": "cta", "label": "CTA", "default": "Shop Pouches" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "max_blocks": 2,
  "presets": [{
    "name": "Format discovery",
    "blocks": [
      { "type": "format", "settings": { "title": "Your everyday staple", "text": "Keep your favourite formula ready for a consistent at-home routine.", "cta": "Shop Pouches" } },
      { "type": "format", "settings": { "title": "Wellness, wherever you go", "text": "Single-serve convenience for work, travel, gym bags, and busy days.", "cta": "Shop Sachets" } }
    ]
  }]
}
{% endschema %}
