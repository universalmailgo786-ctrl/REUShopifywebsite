<section class="section">
  <div class="wrap">
    <div class="section-head section-head--center" style="max-width:40rem">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | newline_to_br }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin:1rem auto 0">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    <div class="format-split">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- assign href = block.settings.link -%}
        {%- if href == blank and col != blank -%}{%- assign href = col.url -%}{%- endif -%}
        <article class="format-card" {{ block.shopify_attributes }}>
          <div class="format-card__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '600,900,1200', sizes: '(min-width:900px) 45vw, 100vw', loading: 'lazy', alt: block.settings.title | escape }}
            {%- elsif block.settings.fallback_asset != blank -%}
              <img src="{{ block.settings.fallback_asset | asset_url }}" width="1800" height="1200" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- elsif col.featured_image -%}
              {{ col.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="format-card__body">
            <h3 class="h3">{{ block.settings.title }}</h3>
            <p class="text-muted">{{ block.settings.text }}</p>
            <a class="btn" href="{{ href | default: routes.all_products_collection_url }}">{{ block.settings.cta }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Format discovery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Choose your format" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "One routine.\nTwo ways to enjoy it." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Keep your daily favourites at home in a full-size pouch or take the same REÚ experience with you in convenient single-serve sachets." }
  ],
  "blocks": [
    { "type": "format", "name": "Format", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename" },
      { "type": "text", "id": "title", "label": "Title", "default": "Pouch Collection" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Your everyday staple for a consistent at-home routine." },
      { "type": "text", "id": "cta", "label": "CTA", "default": "Shop Pouches" },
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "url", "id": "link", "label": "Fallback link" }
    ]}
  ],
  "max_blocks": 2,
  "presets": [{
    "name": "Format discovery",
    "blocks": [
      { "type": "format", "settings": { "fallback_asset": "reu-format-pouch.jpg", "title": "Pouch Collection", "text": "Your everyday staple for a consistent at-home routine.", "cta": "Shop Pouches" } },
      { "type": "format", "settings": { "fallback_asset": "reu-format-sachet.jpg", "title": "Sachet Collection", "text": "Single-serve convenience for work, travel, gym bags, and busy days.", "cta": "Shop Sachets" } }
    ]
  }]
}
{% endschema %}
