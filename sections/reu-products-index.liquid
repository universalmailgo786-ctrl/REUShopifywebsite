{%- comment -%}
  Products index page — all REÚ products in the Soxa-inspired card grid.
  Assign template "products" to a page with handle `products`.
{%- endcomment -%}
{%- liquid
  assign pouch = collections['pouch-collection']
  if pouch == blank
    assign pouch = collections.pouches
  endif
  assign sachet = collections['sachet-collection']
  if sachet == blank
    assign sachet = collections.sachets
  endif
-%}
<section class="section reu-products-index">
  <div class="wrap">
    <header class="section-head section-head--center" style="margin-bottom:clamp(1.5rem,3vw,2.5rem)">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h2">{{ section.settings.heading | default: page.title | default: 'Shop REÚ Products' }}</h1>
      {%- if section.settings.body != blank -%}
        <p class="lede" style="margin-top:.75rem;max-width:40rem;margin-inline:auto">{{ section.settings.body }}</p>
      {%- endif -%}
      <div style="display:flex;flex-wrap:wrap;gap:.65rem;justify-content:center;margin-top:1.25rem">
        <a class="btn btn--secondary" href="{{ pages.collections.url | default: '/pages/collections' }}">Compare Formats</a>
        <a class="btn" href="{{ pages['find-your-reu'].url | default: pages.quiz.url | default: '/pages/find-your-reu' }}">Find My Routine <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
      </div>
    </header>

    <div class="reu-pdp-range__grid" role="list">
      {%- assign rendered = 0 -%}
      {%- if pouch != blank -%}
        {%- for product in pouch.products -%}
          {%- assign rendered = rendered | plus: 1 -%}
          <a class="reu-pdp-card" href="{{ product.url }}" role="listitem">
            <div class="reu-pdp-card__media">
              {%- if settings.preorder_mode and product.available -%}<span class="badge badge--preorder reu-pdp-card__badge">{{ 'products.product.preorder' | t }}</span>{%- endif -%}
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280,420,700', sizes: '(min-width:1100px) 22vw, (min-width:750px) 30vw, 45vw', alt: product.title | escape }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="reu-pdp-card__body">
              <h2 class="reu-pdp-card__title">{{ product.title }}</h2>
              {%- if product.metafields.custom.flavor != blank -%}
                <p class="reu-pdp-card__meta">{{ product.metafields.custom.flavor.value | default: product.metafields.custom.flavor }}</p>
              {%- endif -%}
              <p class="reu-pdp-card__price">{% render 'price', product: product %}</p>
              <span class="reu-pdp-card__cta">{% if settings.preorder_mode %}Pre-Order →{% else %}View product →{% endif %}</span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
      {%- if sachet != blank -%}
        {%- for product in sachet.products -%}
          {%- assign rendered = rendered | plus: 1 -%}
          <a class="reu-pdp-card" href="{{ product.url }}" role="listitem">
            <div class="reu-pdp-card__media">
              {%- if settings.preorder_mode and product.available -%}<span class="badge badge--preorder reu-pdp-card__badge">{{ 'products.product.preorder' | t }}</span>{%- endif -%}
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280,420,700', sizes: '(min-width:1100px) 22vw, (min-width:750px) 30vw, 45vw', alt: product.title | escape }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="reu-pdp-card__body">
              <h2 class="reu-pdp-card__title">{{ product.title }}</h2>
              {%- if product.metafields.custom.flavor != blank -%}
                <p class="reu-pdp-card__meta">{{ product.metafields.custom.flavor.value | default: product.metafields.custom.flavor }}</p>
              {%- endif -%}
              <p class="reu-pdp-card__price">{% render 'price', product: product %}</p>
              <span class="reu-pdp-card__cta">{% if settings.preorder_mode %}Pre-Order →{% else %}View product →{% endif %}</span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
      {%- if rendered == 0 -%}
        {%- for product in collections.all.products -%}
          <a class="reu-pdp-card" href="{{ product.url }}" role="listitem">
            <div class="reu-pdp-card__media">
              {%- if settings.preorder_mode and product.available -%}<span class="badge badge--preorder reu-pdp-card__badge">{{ 'products.product.preorder' | t }}</span>{%- endif -%}
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280,420,700', sizes: '(min-width:1100px) 22vw, (min-width:750px) 30vw, 45vw', alt: product.title | escape }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="reu-pdp-card__body">
              <h2 class="reu-pdp-card__title">{{ product.title }}</h2>
              <p class="reu-pdp-card__price">{% render 'price', product: product %}</p>
              <span class="reu-pdp-card__cta">View product →</span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if rendered == 0 and collections.all.products_count == 0 -%}
      <div class="text-center" style="margin-top:2rem">
        <p class="lede">No products are published yet. Import the REÚ product CSV, set products to Active, then refresh this page.</p>
        <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}" style="margin-top:1rem">View Shop All</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Products index",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP REÚ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All products" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Explore every REÚ pouch and sachet. Open any product for the full pre-order details." }
  ],
  "presets": [{ "name": "Products index" }]
}
{% endschema %}
