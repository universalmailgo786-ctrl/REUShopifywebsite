{%- comment -%}
  Products index page — all REÚ products in the Soxa-inspired card grid.
  Assign template "products" to a page with handle `products`.
{%- endcomment -%}
{%- liquid
  assign pouch = collections['pouch-collection']
  if pouch == blank
    assign pouch = collections.pouches
  endif
  assign sachet = collections['sachet-collection']
  if sachet == blank
    assign sachet = collections.sachets
  endif
  assign quiz_url = pages['find-your-reu'].url | default: pages.quiz.url | default: '/pages/find-your-reu'
-%}
<section class="reu-products-page">
  <div class="reu-products-hero">
    <div class="reu-products-hero__media" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            widths: '900,1400,1800,2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      {%- else -%}
        <img
          src="{{ section.settings.fallback_asset | default: 'reu-products-hero.jpg' | asset_url }}"
          width="2400"
          height="1200"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- endif -%}
    </div>
    <div class="reu-products-hero__scrim" aria-hidden="true"></div>
    <div class="reu-products-hero__inner wrap">
      <div class="reu-products-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="reu-products-hero__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="reu-products-hero__heading h2">{{ section.settings.heading | default: page.title | default: 'Shop REÚ Products' }}</h1>
        {%- if section.settings.body != blank -%}
          <p class="reu-products-hero__body lede">{{ section.settings.body }}</p>
        {%- endif -%}
        <div class="reu-products-hero__actions">
          <a class="btn" href="{{ quiz_url }}">Find My Routine <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
        </div>
      </div>
    </div>
  </div>

  <div class="reu-products-index section {{ section.settings.bg_scheme | default: 'bg-cream' }}">
    <div class="wrap">
      <div class="reu-pdp-range__grid" role="list">
        {%- assign rendered = 0 -%}
        {%- if pouch != blank -%}
          {%- for product in pouch.products -%}
            {%- assign rendered = rendered | plus: 1 -%}
            {% render 'reu-pdp-card', product: product, heading_tag: 'h2' %}
          {%- endfor -%}
        {%- endif -%}
        {%- if sachet != blank -%}
          {%- for product in sachet.products -%}
            {%- assign rendered = rendered | plus: 1 -%}
            {% render 'reu-pdp-card', product: product, heading_tag: 'h2' %}
          {%- endfor -%}
        {%- endif -%}
        {%- if rendered == 0 -%}
          {%- for product in collections.all.products -%}
            {% render 'reu-pdp-card', product: product, heading_tag: 'h2', cta_label: 'View product →' %}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if rendered == 0 and collections.all.products_count == 0 -%}
        <div class="text-center" style="margin-top:2rem">
          <p class="lede">No products are published yet. Import the REÚ product CSV, set products to Active, then refresh this page.</p>
          <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}" style="margin-top:1rem">View Shop All</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Products index",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename", "default": "reu-products-hero.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP REÚ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All products" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Explore every REÚ pouch and sachet. Open any product for the full pre-order details." },
    { "type": "select", "id": "bg_scheme", "label": "Product grid background", "options": [
      { "value": "bg-cream", "label": "Cream" }, { "value": "bg-sage", "label": "Sage" }
    ], "default": "bg-cream" }
  ],
  "presets": [{ "name": "Products index" }]
}
{% endschema %}
