<section class="section" {% if section.settings.faq_schema %}itemscope itemtype="https://schema.org/FAQPage"{% endif %}>
  <div class="wrap">
    <div class="faq-split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | newline_to_br }}</h2>
        {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:1rem">{{ section.settings.body }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div style="margin-top:1.5rem">
            <a class="btn" href="{{ section.settings.cta_link | default: routes.root_url }}">{{ section.settings.cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
          </div>
        {%- endif -%}
      </div>
      <div class="accordion accordion--faq" data-accordion>
        {%- for block in section.blocks -%}
          <div class="accordion__item" {% if section.settings.faq_schema %}itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"{% endif %} {{ block.shopify_attributes }}>
            <h3>
              <button class="accordion__trigger" id="faq-{{ block.id }}" aria-expanded="false" aria-controls="faq-p-{{ block.id }}">
                <span {% if section.settings.faq_schema %}itemprop="name"{% endif %}>{{ block.settings.question }}</span>
                {% render 'icon', name: 'plus' %}
              </button>
            </h3>
            <div class="accordion__panel" id="faq-p-{{ block.id }}" role="region" aria-labelledby="faq-{{ block.id }}" hidden style="height:0" {% if section.settings.faq_schema %}itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"{% endif %}>
              <div class="rte" {% if section.settings.faq_schema %}itemprop="text"{% endif %}>{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions, answered" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Your essential guide\nto choosing REÚ." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Clear information about our products, formats, pre-orders, shipping, and everyday use." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View All FAQs" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "checkbox", "id": "faq_schema", "label": "Output FAQ schema", "default": true }
  ],
  "blocks": [
    { "type": "qa", "name": "Q&A", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Is REÚ currently available?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>REÚ is currently available for pre-order. Estimated shipping is shown at checkout.</p>" }
    ]}
  ],
  "presets": [{
    "name": "FAQ",
    "blocks": [
      { "type": "qa", "settings": { "question": "Is REÚ currently available?", "answer": "<p>REÚ is currently available for pre-order. Estimated shipping is shown at checkout.</p>" } },
      { "type": "qa", "settings": { "question": "When will I be charged?", "answer": "<p>Your payment timing is confirmed clearly before you complete checkout.</p>" } },
      { "type": "qa", "settings": { "question": "Can I cancel my pre-order?", "answer": "<p>Yes. Contact our support team before your order ships to request cancellation and a full refund.</p>" } },
      { "type": "qa", "settings": { "question": "How do I choose the right product?", "answer": "<p>Take our Product Recommendation Quiz or explore the collection by wellness goal.</p>" } },
      { "type": "qa", "settings": { "question": "Can REÚ products treat a medical condition?", "answer": "<p>No. REÚ products are not intended to diagnose, treat, cure, or prevent any disease.</p>" } }
    ]
  }]
}
{% endschema %}
