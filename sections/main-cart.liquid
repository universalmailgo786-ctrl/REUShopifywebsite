<section class="section bg-cream">
  <div class="wrap wrap--narrow" data-cart-page>
    <h1 class="h2" style="margin-bottom:var(--space-lg)">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="text-center section">
        <p class="lede">{{ 'sections.cart.empty' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}" style="margin-top:1rem">{{ 'sections.cart.empty_cta' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart">
        {%- for item in cart.items -%}
          <div class="cart-line" data-cart-line="{{ forloop.index }}">
            <a class="cart-line__img" href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 128 | image_tag: loading: 'lazy', alt: item.title | escape }}{%- endif -%}</a>
            <div>
              <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.variant.title contains 'Default' -%}<div class="cart-line__meta">{{ item.variant.title }}</div>{%- endunless -%}
              {%- if settings.preorder_mode -%}<div class="cart-line__meta"><span class="badge badge--preorder">{{ 'products.product.preorder' | t }}</span> {{ 'sections.cart.preorder_line' | t }}</div>{%- endif -%}
              <div class="qty-control" data-qty style="margin-top:.5rem">
                <button type="button" data-line-change data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'products.product.decrease' | t }}">–</button>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity' | t }}">
                <button type="button" data-line-change data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'products.product.increase' | t }}">+</button>
              </div>
            </div>
            <div style="text-align:right">
              <div class="cart-line__title">{{ item.final_line_price | money }}</div>
              <a class="filter-chip" style="margin-top:.5rem" href="{{ item.url_to_remove }}">{{ 'sections.cart.remove' | t }}</a>
            </div>
          </div>
        {%- endfor -%}

        {%- if settings.cart_show_note -%}
          <label class="field" style="margin-top:var(--space-md)"><span>{{ 'sections.cart.note' | t }}</span>
            <textarea class="textarea" name="note">{{ cart.note }}</textarea>
          </label>
        {%- endif -%}

        <div class="cart-subtotal" style="margin-top:var(--space-lg)"><span>{{ 'sections.cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>
        <p class="form-note">{{ 'sections.cart.taxes_note' | t }}</p>
        <div style="display:flex;gap:.75rem;margin-top:var(--space-md)">
          <button type="submit" name="update" class="btn btn--secondary">{{ 'sections.cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn" style="flex:1">{{ 'sections.cart.checkout' | t }}</button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
