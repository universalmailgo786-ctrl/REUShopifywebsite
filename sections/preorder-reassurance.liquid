{%- liquid
  assign ship_window = section.settings.ship_window
  if ship_window == blank
    assign ship_window = settings.preorder_ship_window
  endif
-%}
<section class="section bg-cream">
  <div class="wrap">
    <div class="preorder-split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | newline_to_br }}</h2>
        {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:1rem">{{ section.settings.body }}</p>{%- endif -%}
        {%- if ship_window != blank -%}
          <p class="notice" style="margin-top:1rem">Estimated shipping: {{ ship_window }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div style="margin-top:1.5rem">
            <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
          </div>
        {%- endif -%}
      </div>
      <div class="preorder-split__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '600,900,1200', sizes: '(min-width:900px) 45vw, 100vw', loading: 'lazy', alt: section.settings.heading | escape }}
        {%- else -%}
          <img src="{{ 'reu-sachet-collection.jpg' | asset_url }}" width="2000" height="1333" alt="" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Pre-order reassurance",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "First release" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Reserve your\nREÚ favourites." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Pre-order today to secure your products from the first production release. We’ll keep you informed by email, and you may cancel for a full refund at any time before shipment." },
    { "type": "text", "id": "ship_window", "label": "Estimated shipping window", "info": "Leave blank until confirmed in writing." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Pre-Order" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Pre-order reassurance" }]
}
{% endschema %}
