{%- liquid
  assign window = section.settings.window | default: settings.preorder_ship_window
-%}
<section class="section">
  <div class="wrap">
    <div class="bg-green" style="border-radius:var(--radius-lg);padding:clamp(2rem,5vw,3.5rem);text-align:center">
      <span class="icon-circle" style="background:rgba(255,255,255,.12);color:#fff">{% render 'icon', name: 'shield' %}</span>
      <h2 class="h2" style="margin-top:.75rem">{{ section.settings.heading }}</h2>
      <div class="lede" style="margin:1rem auto 0;max-width:40rem;color:var(--color-cream)">
        <p>{{ section.settings.body }}
        {%- if window != blank %} Estimated shipping is <strong>{{ window }}</strong>.{% endif -%}
        </p>
      </div>
      {%- if section.settings.cta_label != blank -%}
        <div style="margin-top:1.5rem"><a class="btn btn--on-green btn--lg" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Pre-order reassurance",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reserve your REÚ favourites" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Pre-order today to secure your products from the first production release. We will keep you informed by email, and you may cancel for a full refund any time before shipment." },
    { "type": "text", "id": "window", "label": "Shipping window (overrides global)", "info": "Leave blank to use the global pre-order setting. Never publish an unconfirmed date." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Pre-Order" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "Pre-order reassurance" }]
}
{% endschema %}
