{%- liquid
  assign menu = section.settings.menu
  assign sticky = section.settings.sticky
  assign products_label = section.settings.products_nav_label | default: 'Products'
  assign products_url = section.settings.products_nav_link
  if products_url == blank
    if pages.products != blank
      assign products_url = pages.products.url
    else
      assign products_url = routes.all_products_collection_url
    endif
  endif
  assign inject_products = section.settings.show_products_nav
  assign products_already_in_menu = false
  if menu != blank
    for link in menu.links
      assign t = link.title | downcase
      if t == 'products' or t == 'shop all' or t == 'shop' or link.url == products_url or link.url == routes.all_products_collection_url
        assign products_already_in_menu = true
      endif
      for child in link.links
        assign ct = child.title | downcase
        if ct == 'products' or child.url == products_url
          assign products_already_in_menu = true
        endif
      endfor
    endfor
  endif
-%}
<header class="site-header{% if sticky %} is-sticky{% endif %}" data-site-header style="--logo-w: {{ settings.logo_width }}px">
  <div class="wrap">
    <div class="site-header__inner">
      <button class="header-icon menu-toggle" data-drawer-open="MobileMenu" aria-label="{{ 'accessibility.open_menu' | t }}" aria-controls="MobileMenu">
        {% render 'icon', name: 'menu' %}
      </button>

      <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — home">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 520 | image_tag: widths: '130,260,390,520', alt: shop.name, loading: 'eager', fetchpriority: 'high' }}
        {%- else -%}
          <img src="{{ 'reu-logo.png' | asset_url }}" width="1817" height="1001" alt="{{ shop.name }}" fetchpriority="high">
        {%- endif -%}
      </a>

      <nav class="site-header__nav" aria-label="Primary">
        {%- if menu != blank and menu.links.size > 0 -%}
          {%- assign inserted_products = false -%}
          {%- for link in menu.links -%}
            {%- if link.links.size > 0 -%}
              <div class="has-dropdown">
                <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %} aria-haspopup="true">{{ link.title }} {% render 'icon', name: 'chevron-down' %}</a>
                <div class="dropdown">
                  {%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}
                </div>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}

            {%- liquid
              assign link_title_l = link.title | downcase
              assign is_collections_link = false
              if link_title_l == 'collections' or link_title_l == 'shop by collection' or link.url contains '/pages/collections'
                assign is_collections_link = true
              endif
            -%}
            {%- if inject_products and is_collections_link and products_already_in_menu == false and inserted_products == false -%}
              <a href="{{ products_url }}" {% if request.path == products_url or request.path == '/pages/products' %}aria-current="page"{% endif %}>{{ products_label }}</a>
              {%- assign inserted_products = true -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if inject_products and products_already_in_menu == false and inserted_products == false -%}
            <a href="{{ products_url }}" {% if request.path == products_url or request.path == '/pages/products' %}aria-current="page"{% endif %}>{{ products_label }}</a>
          {%- endif -%}
        {%- else -%}
          <a href="{{ routes.root_url }}">Home</a>
          <a href="{{ pages.collections.url | default: '/pages/collections' }}">Collections</a>
          <a href="{{ products_url }}">{{ products_label }}</a>
          <a href="{{ pages['about-reu'].url | default: '/pages/about-reu' }}">About</a>
          <a href="{{ pages['find-your-reu'].url | default: '/pages/find-your-reu' }}">Quiz</a>
        {%- endif -%}
      </nav>

      <div class="site-header__actions">
        <button class="header-icon" data-drawer-open="SearchDrawer" aria-label="{{ 'accessibility.search' | t }}" aria-controls="SearchDrawer">{% render 'icon', name: 'search' %}</button>
        {%- if shop.customer_accounts_enabled -%}
          <a class="header-icon" href="{{ routes.account_url }}" aria-label="{{ 'accessibility.account' | t }}">{% render 'icon', name: 'user' %}</a>
        {%- endif -%}
        <button class="header-icon" data-drawer-open="CartDrawer" aria-label="{{ 'accessibility.cart' | t }}" aria-controls="CartDrawer">
          {% render 'icon', name: 'cart' %}
          <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>
</header>

{%- comment -%} Mobile menu drawer {%- endcomment -%}
<div id="MobileMenu" class="drawer drawer--left" data-drawer hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}">
  <div class="drawer__overlay" data-drawer-overlay></div>
  <div class="drawer__panel">
    <div class="drawer__header">
      <span class="drawer__title">{{ 'accessibility.menu' | t }}</span>
      <button class="header-icon" data-drawer-close="MobileMenu" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <nav class="drawer__body mobile-nav" aria-label="Mobile">
      {%- if menu != blank and menu.links.size > 0 -%}
        {%- assign inserted_products_m = false -%}
        {%- for link in menu.links -%}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <div class="mobile-nav__sub">
              {%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}
            </div>
          {%- endif -%}
          {%- liquid
            assign link_title_l = link.title | downcase
            assign is_collections_link = false
            if link_title_l == 'collections' or link_title_l == 'shop by collection' or link.url contains '/pages/collections'
              assign is_collections_link = true
            endif
          -%}
          {%- if inject_products and is_collections_link and products_already_in_menu == false and inserted_products_m == false -%}
            <a href="{{ products_url }}">{{ products_label }}</a>
            {%- assign inserted_products_m = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if inject_products and products_already_in_menu == false and inserted_products_m == false -%}
          <a href="{{ products_url }}">{{ products_label }}</a>
        {%- endif -%}
      {%- else -%}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ pages.collections.url | default: '/pages/collections' }}">Collections</a>
        <a href="{{ products_url }}">{{ products_label }}</a>
        <a href="{{ pages['about-reu'].url | default: '/pages/about-reu' }}">About</a>
        <a href="{{ pages['find-your-reu'].url | default: '/pages/find-your-reu' }}">Quiz</a>
      {%- endif -%}
    </nav>
  </div>
</div>

{%- comment -%} Search drawer with recommended + predictive results {%- endcomment -%}
{%- liquid
  assign recommend_collection = collections.all
  if section.settings.search_collection != blank
    assign recommend_collection = collections[section.settings.search_collection]
  endif
-%}
<div id="SearchDrawer" class="drawer drawer--right search-drawer" data-drawer hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
  <div class="drawer__overlay" data-drawer-overlay></div>
  <div class="drawer__panel">
    <div class="drawer__header">
      <span class="drawer__title">{{ 'general.search.search' | t }}</span>
      <button type="button" class="header-icon search-drawer__close" data-drawer-close="SearchDrawer" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body search-drawer__body" data-predictive>
      <form class="search-drawer__form" action="{{ routes.search_url }}" method="get" role="search" data-search-form>
        <input type="hidden" name="type" value="product,article,page">
        <label class="visually-hidden" for="SearchDrawer-Input-{{ section.id }}">{{ 'general.search.search' | t }}</label>
        <div class="search-drawer__field">
          <input
            class="search-drawer__input"
            id="SearchDrawer-Input-{{ section.id }}"
            type="search"
            name="q"
            value=""
            placeholder="{{ 'general.search.placeholder' | t }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            data-search-input
          >
          <button class="search-drawer__submit" type="submit" aria-label="{{ 'general.search.search' | t }}">
            {% render 'icon', name: 'search' %}
          </button>
        </div>
      </form>

      <div class="search-drawer__results" data-predictive-results>
        <div data-search-recommended>
          {%- if recommend_collection != blank and recommend_collection.products_count > 0 -%}
            <div class="search-drawer__group">
              <p class="search-drawer__label">Recommended</p>
              <div class="search-drawer__list">
                {%- for product in recommend_collection.products limit: 6 -%}
                  {% render 'search-result-card', product: product %}
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <p class="search-drawer__hint">Start typing to search products, journal articles, and pages.</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "show_products_nav", "label": "Insert Products link after Collections", "default": true, "info": "Adds Products to the main menu after Collections if it is not already in the menu. Create page handle products and assign template products, or leave blank to use Shop All." },
    { "type": "text", "id": "products_nav_label", "label": "Products link label", "default": "Products" },
    { "type": "url", "id": "products_nav_link", "label": "Products link URL", "info": "Optional. Defaults to /pages/products, then Shop All." },
    { "type": "collection", "id": "search_collection", "label": "Recommended search products" }
  ]
}
{% endschema %}
