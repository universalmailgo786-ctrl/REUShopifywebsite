{%- comment -%}
  Social section. Shows real images added as blocks, or an app block (real feed).
  Never displays fabricated posts. Hidden entirely if no content is configured.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if settings.social_instagram != blank -%}<p class="lede" style="margin-top:.5rem"><a class="link-arrow" href="{{ settings.social_instagram }}" rel="noopener" target="_blank">{{ section.settings.handle }}</a></p>{%- endif -%}
    </div>
    <div class="grid cols-4">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            <a class="media-ratio" style="aspect-ratio:1;border-radius:var(--radius);overflow:hidden" href="{{ block.settings.link | default: settings.social_instagram | default: '#' }}" rel="noopener" target="_blank" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 500 | image_tag: widths: '250,400,500', sizes: '(min-width:750px) 25vw, 50vw', loading: 'lazy', alt: block.settings.alt | escape }}{%- endif -%}
            </a>
          {%- when '@app' -%}
            <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section"><div class="wrap"><p class="notice">Add real Instagram images or a social feed app block to show this section. It stays hidden on the live site until real content is added.</p></div></section>
{%- endif -%}
{% schema %}
{
  "name": "Social feed",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Follow along" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@REU" },
    { "type": "text", "id": "handle", "label": "Handle text", "default": "Follow us on Instagram" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }
    ], "default": "" }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "alt", "label": "Alt text" },
      { "type": "url", "id": "link", "label": "Link" }
    ]},
    { "type": "@app" }
  ],
  "presets": [{ "name": "Social feed" }]
}
{% endschema %}
