{%- comment -%}
  Social grid using REÚ product imagery. Links default to # until real profiles are set.
{%- endcomment -%}
<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <p class="lede" style="margin-top:.5rem">
        <a class="link-arrow" href="{{ settings.social_instagram | default: '#' }}">{{ section.settings.handle }}</a>
      </p>
    </div>
    <div class="social-grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            {%- assign href = block.settings.link | default: '#' -%}
            <a class="social-grid__item" href="{{ href }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag: widths: '280,420,700', sizes: '(min-width:990px) 25vw, 50vw', loading: 'lazy', alt: block.settings.alt | default: 'REÚ' | escape }}
              {%- elsif block.settings.fallback_asset != blank -%}
                <img src="{{ block.settings.fallback_asset | asset_url }}" width="1200" height="1200" alt="{{ block.settings.alt | default: 'REÚ' | escape }}" loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
          {%- when '@app' -%}
            <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Social feed",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Follow along" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@REÚ" },
    { "type": "text", "id": "handle", "label": "Handle text", "default": "Follow us on Instagram" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-blush", "label": "Blush" }
    ], "default": "bg-cream" }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename" },
      { "type": "text", "id": "alt", "label": "Alt text" },
      { "type": "url", "id": "link", "label": "Link (leave blank for #)" }
    ]},
    { "type": "@app" }
  ],
  "presets": [{
    "name": "Social feed",
    "blocks": [
      { "type": "image", "settings": { "fallback_asset": "reu-hydration-watermelon.jpg", "alt": "REÚ Hydration" } },
      { "type": "image", "settings": { "fallback_asset": "reu-collagen-mixed-berry.jpg", "alt": "REÚ Collagen" } },
      { "type": "image", "settings": { "fallback_asset": "reu-greens-pineapple.jpg", "alt": "REÚ Greens" } },
      { "type": "image", "settings": { "fallback_asset": "reu-format-sachet.jpg", "alt": "REÚ Sachets" } }
    ]
  }]
}
{% endschema %}
