{%- liquid
  assign s = section.settings
  assign goal_link = s.goal_page_url | default: routes.all_products_collection_url
-%}
<section class="section">
  <div class="wrap">
    <div class="quiz">
      <div class="section-head section-head--center">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h1 class="h2">{{ s.heading }}</h1>
        {%- if s.intro != blank -%}<p class="lede" style="margin-top:.75rem">{{ s.intro }}</p>{%- endif -%}
        {%- if s.consent != blank -%}<p class="form-note" style="margin-top:.75rem">{{ s.consent }}</p>{%- endif -%}
      </div>

      <div data-quiz>
        {%- comment -%} No-JS fallback {%- endcomment -%}
        <div data-quiz-nojs>
          <p class="notice">Prefer to browse? Explore products by wellness goal.</p>
          <div style="margin-top:1rem"><a class="btn" href="{{ goal_link }}">Shop by Goal</a></div>
        </div>

        <div data-quiz-interactive hidden>
          <div class="quiz__progress" aria-hidden="true"><span data-quiz-progress style="width:0%"></span></div>
          <p class="form-note text-center" data-quiz-progress-label aria-live="polite">Question 1</p>

          {%- comment -%} ---- Question steps ---- {%- endcomment -%}
          {%- assign q1 = 'Hydration|hydration,Beauty & collagen|beauty,Daily wellness|wellness,Greens & nutrition|greens,Energy & performance|performance,Weight management|weight,Protein & recovery|protein' | split: ',' -%}
          <fieldset class="quiz__step is-active" data-quiz-step>
            <legend class="h3">What is your main wellness goal?</legend>
            <div class="quiz__options">
              {%- for opt in q1 -%}{%- assign parts = opt | split: '|' -%}
                <label class="quiz__option"><input type="radio" name="q1" value="{{ parts[0] }}" data-goal="{{ parts[1] }}" data-weight="3"><span>{{ parts[0] }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>

          {%- assign q2 = 'Staying hydrated|hydration,Supporting a beauty routine|beauty,Feeling more consistent|wellness,Adding greens|greens,Supporting active days|performance,Building an intentional weight routine|weight,Supporting protein intake|protein' | split: ',' -%}
          <fieldset class="quiz__step" data-quiz-step>
            <legend class="h3">What would you most like to improve?</legend>
            <div class="quiz__options">
              {%- for opt in q2 -%}{%- assign parts = opt | split: '|' -%}
                <label class="quiz__option"><input type="radio" name="q2" value="{{ parts[0] }}" data-goal="{{ parts[1] }}" data-weight="2"><span>{{ parts[0] }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>

          {%- assign q3 = 'Morning,During work,Before exercise,During exercise,After exercise,Evening,Whenever I need it' | split: ',' -%}
          <fieldset class="quiz__step" data-quiz-step>
            <legend class="h3">When would you most likely use your REÚ product?</legend>
            <div class="quiz__options">
              {%- for opt in q3 -%}<label class="quiz__option"><input type="radio" name="q3" value="{{ opt }}"><span>{{ opt }}</span></label>{%- endfor -%}
            </div>
          </fieldset>

          {%- assign q4 = 'Rarely,1–2 days/week,3–4 days/week,5+ days/week' | split: ',' -%}
          <fieldset class="quiz__step" data-quiz-step>
            <legend class="h3">How often do you exercise?</legend>
            <div class="quiz__options">
              {%- for opt in q4 -%}
                {%- assign g = '' -%}{%- if forloop.index >= 3 -%}{%- assign g = 'performance' -%}{%- endif -%}
                <label class="quiz__option"><input type="radio" name="q4" value="{{ opt }}" {% if g != blank %}data-goal="{{ g }}" data-weight="1"{% endif %}><span>{{ opt }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>

          {%- assign q5 = 'Berry,Citrus,Tropical,Watermelon,Chocolate,Surprise me' | split: ',' -%}
          <fieldset class="quiz__step" data-quiz-step>
            <legend class="h3">Which flavour profile sounds best?</legend>
            <div class="quiz__options">
              {%- for opt in q5 -%}<label class="quiz__option"><input type="radio" name="q5" value="{{ opt }}" data-flavour><span>{{ opt }}</span></label>{%- endfor -%}
            </div>
          </fieldset>

          {%- assign q6 = 'Full-size pouch,Single-serve sachets,Both,Not sure' | split: ',' -%}
          <fieldset class="quiz__step" data-quiz-step>
            <legend class="h3">Which format fits your routine?</legend>
            <div class="quiz__options">
              {%- for opt in q6 -%}<label class="quiz__option"><input type="radio" name="q6" value="{{ opt }}" data-format><span>{{ opt }}</span></label>{%- endfor -%}
            </div>
          </fieldset>

          {%- assign q7 = '18–24,25–34,35–44,45–54,55+,Prefer not to say' | split: ',' -%}
          <fieldset class="quiz__step" data-quiz-step>
            <legend class="h3">What is your age range?</legend>
            <div class="quiz__options">
              {%- for opt in q7 -%}<label class="quiz__option"><input type="radio" name="q7" value="{{ opt }}"><span>{{ opt }}</span></label>{%- endfor -%}
            </div>
          </fieldset>

          {%- assign q8 = 'Pregnant or nursing|1,Under medical supervision|1,Taking medication|1,Food allergy/sensitivity|1,None|0,Prefer not to say|0' | split: ',' -%}
          <fieldset class="quiz__step" data-quiz-step>
            <legend class="h3">Are any of these relevant?</legend>
            <p class="form-note">Optional. Select all that apply — this helps us show you the right safety information.</p>
            <div class="quiz__options">
              {%- for opt in q8 -%}{%- assign parts = opt | split: '|' -%}
                <label class="quiz__option"><input type="checkbox" name="q8" value="{{ parts[0] }}" {% if parts[1] == '1' %}data-safety{% endif %}><span>{{ parts[0] }}</span></label>
              {%- endfor -%}
            </div>
            <div class="quiz__safety notice" data-quiz-safety hidden>
              Your wellbeing comes first. Please review the full ingredient and allergen information and speak with a qualified healthcare professional before adding a supplement to your routine.
            </div>
          </fieldset>

          {%- comment -%} ---- Result step ---- {%- endcomment -%}
          <div class="quiz__step quiz__result" data-quiz-step data-quiz-result>
            <p class="eyebrow">Your REÚ starting point</p>
            <h2 class="h2">Based on what you shared…</h2>
            <p class="form-note" data-flavour-note hidden style="margin-top:.5rem">You mentioned you enjoy <strong data-flavour-value></strong> — choose that flavour where available.</p>

            {%- for block in section.blocks -%}
              {%- if block.type == 'result' -%}
                <div data-result-goal="{{ block.settings.goal }}" hidden {{ block.shopify_attributes }} style="margin-top:var(--space-md)">
                  <div class="grid cols-2" style="text-align:left">
                    {%- if block.settings.primary != blank -%}{% render 'product-card', product: block.settings.primary %}{%- endif -%}
                    {%- if block.settings.secondary != blank -%}{% render 'product-card', product: block.settings.secondary %}{%- endif -%}
                  </div>
                  {%- if block.settings.primary == blank and block.settings.secondary == blank -%}
                    <p class="notice">Configure recommended products for this goal in the theme editor, or explore the goal below.</p>
                  {%- endif -%}
                  <div style="margin-top:var(--space-md);display:flex;gap:.5rem;flex-wrap:wrap;justify-content:center">
                    {%- if block.settings.primary != blank -%}<a class="btn" href="{{ block.settings.primary.url }}">Pre-Order My Match</a>{%- endif -%}
                    {%- if block.settings.explore_link != blank -%}<a class="btn btn--secondary" href="{{ block.settings.explore_link }}">Explore Another Goal</a>{%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}

            <div data-result-fallback hidden style="margin-top:var(--space-md)">
              <p class="lede">Explore products aligned with your goal.</p>
              <a class="btn" href="{{ goal_link }}" style="margin-top:1rem">Shop by Goal</a>
            </div>

            <div style="margin-top:var(--space-lg)"><button type="button" class="link-arrow" style="background:none;border:0;cursor:pointer" data-quiz-restart>{% render 'icon', name: 'refresh' %} Start over</button></div>
          </div>

          {%- comment -%} ---- Navigation ---- {%- endcomment -%}
          <div class="quiz__nav">
            <button type="button" class="btn btn--secondary" data-quiz-back>{% render 'icon', name: 'arrow-left' %} Back</button>
            <button type="button" class="btn" data-quiz-next>Continue {% render 'icon', name: 'arrow' %}</button>
          </div>
        </div>
      </div>

      {% render 'supplement-disclaimer', compact: true %}
    </div>
  </div>
</section>
<script src="{{ 'quiz.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Quiz",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Your REÚ Routine" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Tell us what you want from your wellness routine. In about 60 seconds, we will recommend a starting product and a simple routine based on your answers." },
    { "type": "textarea", "id": "consent", "label": "Consent note", "default": "This quiz provides general product guidance and is not medical advice. Your answers are not stored." },
    { "type": "url", "id": "goal_page_url", "label": "Shop by Goal link" }
  ],
  "blocks": [
    { "type": "result", "name": "Result mapping", "settings": [
      { "type": "select", "id": "goal", "label": "Goal", "options": [
        { "value": "hydration", "label": "Hydration" }, { "value": "beauty", "label": "Beauty" },
        { "value": "wellness", "label": "Daily Wellness" }, { "value": "greens", "label": "Greens" },
        { "value": "performance", "label": "Performance" }, { "value": "weight", "label": "Weight Management" },
        { "value": "protein", "label": "Protein & Recovery" }
      ], "default": "hydration" },
      { "type": "product", "id": "primary", "label": "Primary recommendation" },
      { "type": "product", "id": "secondary", "label": "Secondary option" },
      { "type": "url", "id": "explore_link", "label": "Explore another goal link" }
    ]}
  ],
  "max_blocks": 7,
  "presets": [{
    "name": "Quiz",
    "blocks": [
      { "type": "result", "settings": { "goal": "hydration" } },
      { "type": "result", "settings": { "goal": "beauty" } },
      { "type": "result", "settings": { "goal": "wellness" } },
      { "type": "result", "settings": { "goal": "greens" } },
      { "type": "result", "settings": { "goal": "performance" } },
      { "type": "result", "settings": { "goal": "weight" } },
      { "type": "result", "settings": { "goal": "protein" } }
    ]
  }]
}
{% endschema %}
