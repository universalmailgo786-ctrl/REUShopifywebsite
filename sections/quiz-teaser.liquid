<section class="section">
  <div class="wrap">
    <div class="bg-green" style="border-radius:var(--radius-lg);padding:clamp(2rem,5vw,3.5rem)">
      <div class="cols-2-1 grid" style="align-items:center">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem;color:var(--color-cream)">{{ section.settings.body }}</p>{%- endif -%}
          <div style="margin-top:1.5rem"><a class="btn btn--on-green btn--lg" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
          {%- if section.settings.microcopy != blank -%}<p class="form-note" style="color:var(--color-blush);margin-top:1rem;max-width:30rem">{{ section.settings.microcopy }}</p>{%- endif -%}
        </div>
        <div class="text-center">
          <span class="icon-circle" style="width:96px;height:96px;background:rgba(255,255,255,.12);color:#fff">{% render 'icon', name: 'sparkle' %}</span>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Quiz teaser",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Not sure where to begin?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet your REÚ routine" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Answer a few quick questions about your goals, lifestyle, and preferences. We will guide you toward the products that best match what you want from your daily wellness routine." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Take the 60-Second Quiz" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "textarea", "id": "microcopy", "label": "Microcopy", "default": "Personalized guidance, not medical advice. Your answers are used only to create your product recommendations unless you separately opt into marketing." }
  ],
  "presets": [{ "name": "Quiz teaser" }]
}
{% endschema %}
