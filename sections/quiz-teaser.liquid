{%- liquid
  assign quiz_url = section.settings.cta_link
  if quiz_url == blank
    assign quiz_url = pages['find-your-reu'].url | default: pages.quiz.url | default: '/pages/find-your-reu'
  endif
-%}
<section class="section bg-cream section-quiz-teaser">
  <div class="wrap">
    <div class="quiz-teaser">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | newline_to_br }}</h2>
        {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:1rem">{{ section.settings.body }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div style="margin-top:1.5rem">
            <a class="btn btn--on-dark" href="{{ quiz_url }}">{{ section.settings.cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
          </div>
        {%- endif -%}
        {%- if section.settings.microcopy != blank -%}<p class="quiz-teaser__micro">{{ section.settings.microcopy }}</p>{%- endif -%}
      </div>
      <div class="quiz-teaser__visual">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '600,900,1200,1600',
              sizes: '(min-width:900px) 40vw, 100vw',
              loading: 'lazy',
              alt: section.settings.heading | escape
          }}
        {%- else -%}
          <img
            src="{{ 'reu-quiz-visual-v3.jpg' | asset_url }}"
            width="1448"
            height="1086"
            alt="{{ section.settings.heading | default: 'Find your REÚ quiz' | escape }}"
            loading="lazy"
            decoding="async"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Quiz teaser",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NOT SURE WHERE TO START?" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Find Your REÚ Routine" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Answer a few simple questions about your wellness goals and discover the products that best fit your everyday routine." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Find My Routine" },
    { "type": "url", "id": "cta_link", "label": "CTA link", "info": "Defaults to the Find Your REÚ quiz page when blank." },
    { "type": "text", "id": "microcopy", "label": "Microcopy", "default": "Personalized product guidance, not medical advice." },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Quiz teaser" }]
}
{% endschema %}
