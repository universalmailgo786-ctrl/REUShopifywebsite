<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    <div class="grid cols-4">
      {%- for block in section.blocks -%}
        <div class="card" style="padding:var(--space-md)" {{ block.shopify_attributes }}>
          <span class="icon-circle">{% render 'icon', name: block.settings.icon %}</span>
          <h3 class="h4" style="margin-top:.5rem">{{ block.settings.title }}</h3>
          <p class="text-muted" style="margin-top:.4rem">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Brand benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why REÚ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wellness without the guesswork" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "High-quality wellness should feel clear, enjoyable, and realistic enough for every day." },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-lilac", "label": "Lilac" }
    ], "default": "bg-lilac" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "sparkle", "label": "Sparkle" }, { "value": "check", "label": "Check" }, { "value": "heart", "label": "Heart" },
        { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "sun", "label": "Sun" }
      ], "default": "sparkle" },
      { "type": "text", "id": "title", "label": "Title", "default": "Thoughtfully made" },
      { "type": "text", "id": "text", "label": "Text", "default": "Products created with quality and everyday use in mind." }
    ]}
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Brand benefits",
    "blocks": [
      { "type": "benefit", "settings": { "icon": "sparkle", "title": "Thoughtfully made", "text": "Products created with quality and everyday use in mind." } },
      { "type": "benefit", "settings": { "icon": "check", "title": "Clear by design", "text": "Straightforward product information so you can choose with confidence." } },
      { "type": "benefit", "settings": { "icon": "heart", "title": "Easy to enjoy", "text": "Great-tasting formats made to fit your routine." } },
      { "type": "benefit", "settings": { "icon": "sun", "title": "Created for women", "text": "A modern wellness experience shaped around women’s real lives." } }
    ]
  }]
}
{% endschema %}
