{%- liquid
  assign p = product
  assign preorder = false
  if settings.preorder_mode and p.available
    assign preorder = true
  endif
  assign mf = p.metafields.custom
  assign current = p.selected_or_first_available_variant
  assign format_label = mf.format.value | default: mf.format
  if format_label == blank
    if p.handle contains 'sachet'
      assign format_label = 'Sachet'
    elsif p.handle contains 'pouch'
      assign format_label = 'Pouch'
    endif
  endif
  assign desc_plain = p.description | strip_html
  assign show_description = false
  if p.description != blank
    unless desc_plain contains '[EDITABLE' or desc_plain contains 'editable placeholders'
      assign show_description = true
    endunless
  endif
-%}
<section class="reu-pdp" data-product-root data-preorder="{{ preorder }}">
  <div class="wrap">
    <div class="reu-pdp__banner">
      {% render 'breadcrumbs' %}
    </div>

    <div class="reu-pdp__layout" data-sticky-anchor>
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="reu-pdp__gallery" data-gallery>
        <div class="reu-pdp__stage">
          {%- if p.featured_media -%}
            {{ p.featured_media | image_url: width: 1600 | image_tag:
              widths: '600,900,1200,1600',
              sizes: '(min-width:990px) 48vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              id: 'gallery-main',
              alt: p.featured_media.alt | default: p.title | escape }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if p.media.size > 1 -%}
          <div class="reu-pdp__thumbs" role="list">
            {%- for media in p.media -%}
              <button
                class="reu-pdp__thumb"
                type="button"
                role="listitem"
                data-media-id="{{ media.id }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ media.alt | default: p.title | escape }}"
                onclick="var m=document.getElementById('gallery-main'); if(!m) return; m.src=this.querySelector('img').src.replace(/width=\d+/,'width=1600'); m.srcset=''; this.parentNode.querySelectorAll('[aria-current]').forEach(function(b){b.setAttribute('aria-current','false')}); this.setAttribute('aria-current','true');"
              >
                {{ media | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,180', alt: media.alt | default: p.title | escape }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="reu-pdp__info product__info">
        <div class="reu-pdp__meta-row">
          <span class="reu-pdp__stock">
            <span class="reu-pdp__stock-dot" aria-hidden="true"></span>
            {%- if preorder -%}Pre-order{%- elsif p.available -%}Ready to order{%- else -%}Unavailable{%- endif -%}
          </span>
          {%- if format_label != blank -%}
            <span>Format: <strong>{{ format_label }}</strong></span>
          {%- endif -%}
          {%- if mf.goal != blank -%}
            <span>Goal: <strong>{{ mf.goal }}</strong></span>
          {%- endif -%}
        </div>

        <h1 class="reu-pdp__title">{{ p.title }}</h1>
        {%- if mf.flavor != blank -%}
          <p class="reu-pdp__flavor">{{ mf.flavor }}{% if mf.goal != blank %} · {{ mf.goal }}{% endif %}</p>
        {%- endif -%}

        {%- if p.metafields.reviews.rating.value != blank -%}
          {%- assign rating = p.metafields.reviews.rating.value -%}
          <p class="reu-pdp__meta-row" style="margin-top:-.35rem">
            <span class="badge" aria-label="{{ 'accessibility.star_reviews' | t: rating: rating.rating }}">{% render 'icon', name: 'star' %} {{ rating.rating }} / 5 · {{ p.metafields.reviews.rating_count.value | default: 0 }} reviews</span>
          </p>
        {%- endif -%}

        <div class="reu-pdp__price">{% render 'price', product: p, variant: current, context: 'product' %}</div>
        {%- if preorder -%}<p class="form-note" style="margin:-.35rem 0 1rem">Payment timing is confirmed at checkout.</p>{%- endif -%}

        {% render 'reu-product-summary', product: p %}

        {%- if mf.also_available_handle != blank -%}
          {%- assign alt_product = all_products[mf.also_available_handle] -%}
          {%- if alt_product != blank -%}
            <p class="reu-pdp__also">
              <a class="link-arrow" href="{{ alt_product.url }}">
                {{ mf.also_available_label | default: 'Also available in another format' }}
                {% render 'icon', name: 'arrow' %}
              </a>
            </p>
          {%- endif -%}
        {%- endif -%}

        <form class="reu-pdp__form" data-product-form action="{{ routes.cart_add_url }}" method="post">
          {%- unless p.has_only_default_variant -%}
            {%- for option in p.options_with_values -%}
              {%- assign option_index = forloop.index0 -%}
              <div class="reu-pdp__options option-group" data-option-index="{{ option_index }}">
                <span class="reu-pdp__option-label">{{ option.name }}</span>
                <div class="reu-pdp__pills option-pills">
                  {%- for value in option.values -%}
                    {%- assign oid = 'opt-' | append: option_index | append: '-' | append: forloop.index0 -%}
                    <input type="radio" id="{{ oid }}" name="option-{{ option_index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                    <label for="{{ oid }}">{{ value }}</label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ current.id }}">

          {% render 'reu-product-countdown', product: p, style: 'product' %}

          <div class="reu-pdp__buy purchase-row">
            <div class="reu-pdp__qty qty-control" data-qty>
              <button type="button" data-qty-step="-1" aria-label="{{ 'products.product.decrease' | t }}">–</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
              <button type="button" data-qty-step="1" aria-label="{{ 'products.product.increase' | t }}">+</button>
            </div>
            <button type="submit" class="btn btn--lg reu-pdp__atc" data-add-btn {% unless current.available %}disabled{% endunless %}>
              <span>
                {%- if current.available -%}
                  {% if preorder %}{{ 'products.product.preorder' | t }}{% else %}{{ 'products.product.add_to_cart' | t }}{% endif %}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
              <span class="btn__arrow" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
            </button>
          </div>

          {%- if preorder -%}
            {% render 'preorder-notice', product: p %}
            <p class="form-note" style="margin-top:.75rem">This product is available for pre-order and is not ready for immediate shipment. The current estimated shipping window and payment timing are shown before checkout. You may cancel an unshipped pre-order for a full refund by contacting our support team.</p>
          {%- endif -%}
        </form>

        <ul class="reu-pdp__trust">
          <li>{% render 'icon', name: 'truck' %}<span>{% if mf.preorder_ship_window != blank %}Estimated shipping: {{ mf.preorder_ship_window }}.{% else %}Shipping window shown at checkout.{% endif %}</span></li>
          <li>{% render 'icon', name: 'refresh' %}<span>Cancel a pre-order for a full refund any time before shipment.</span></li>
          <li>{% render 'icon', name: 'shield' %}<span>Secure checkout. Questions? {% if settings.support_email != blank %}<a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>{% else %}Contact our support team.{% endif %}</span></li>
        </ul>
      </div>
    </div>

    {%- comment -%} Detail panels {%- endcomment -%}
    <div class="reu-pdp__details">
      <div class="reu-pdp__panel">
        <h2>Why you’ll love it</h2>
        {%- liquid
          assign benefits_text = ''
          if mf.key_benefits != blank
            assign benefits_text = mf.key_benefits | metafield_text | strip_html
          endif
          assign how_text = ''
          if mf.how_to_use != blank
            assign how_text = mf.how_to_use | metafield_text | strip_html
          elsif mf.directions != blank
            assign how_text = mf.directions | metafield_text | strip_html
          endif

          assign show_benefits = false
          if benefits_text != blank
            unless benefits_text contains '[EDITABLE' or benefits_text contains 'editable placeholders'
              assign show_benefits = true
            endunless
          endif

          assign show_how = false
          if how_text != blank
            unless how_text contains '[EDITABLE' or how_text contains 'editable placeholders'
              assign show_how = true
            endunless
          endif
        -%}
        {%- if show_benefits -%}
          <div class="rte">{{ mf.key_benefits | metafield_tag }}</div>
        {%- else -%}
          <ul class="reu-pdp__ritual">
            <li>Made to support an everyday wellness goal.</li>
            <li>A flavour designed to make consistency more enjoyable.</li>
            <li>Available in a full-size pouch and convenient single serves where confirmed.</li>
            <li>Clear directions and supplier-verified product information.</li>
          </ul>
        {%- endif -%}

        <h2 style="margin-top:1.75rem">Make it part of your day</h2>
        {%- if show_how -%}
          <div class="rte">
            {%- if mf.how_to_use != blank -%}{{ mf.how_to_use | metafield_tag }}{%- else -%}{{ mf.directions | metafield_tag }}{%- endif -%}
          </div>
        {%- endif -%}
        <p class="reu-pdp__ritual form-note" style="margin-top:.65rem">Follow the serving size, mixing method, timing and frequency printed on the verified product label. Do not exceed the recommended use.</p>

        {%- if show_description -%}
          <div class="rte" style="margin-top:1.5rem">{{ p.description }}</div>
        {%- endif -%}
      </div>

      <div class="reu-pdp__panel">
        <div class="accordion" data-accordion>
          {%- assign rows = 'benefits:Benefits,ingredients:Ingredients,supplement_facts:Supplement Facts,how_to_use:How to Use,format_details:Flavour & Format,warnings_allergens:Warnings & Allergens' | split: ',' -%}
          {%- for row in rows -%}
            {%- assign parts = row | split: ':' -%}
            {%- assign key = parts[0] -%}
            {%- assign label = parts[1] -%}
            {%- assign val = mf[key] -%}
            {%- assign val_text = '' -%}
            {%- if val != blank -%}
              {%- assign val_text = val | metafield_text | strip_html -%}
            {%- endif -%}
            {%- assign show_row = false -%}
            {%- if val != blank -%}
              {%- unless val_text contains '[EDITABLE' or val_text contains 'editable placeholders' -%}
                {%- assign show_row = true -%}
              {%- endunless -%}
            {%- endif -%}
            {%- if show_row -%}
              <div class="accordion__item">
                <h3>
                  <button class="accordion__trigger" id="acc-{{ key }}" aria-expanded="false" aria-controls="acc-p-{{ key }}">
                    <span>{{ label }}</span>{% render 'icon', name: 'plus' %}
                  </button>
                </h3>
                <div class="accordion__panel" id="acc-p-{{ key }}" role="region" aria-labelledby="acc-{{ key }}" hidden style="height:0">
                  <div class="rte">{{ val | metafield_tag }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          <div class="accordion__item">
            <h3>
              <button class="accordion__trigger" id="acc-preorder" aria-expanded="false" aria-controls="acc-p-preorder">
                <span>Pre-Order &amp; Shipping</span>{% render 'icon', name: 'plus' %}
              </button>
            </h3>
            <div class="accordion__panel" id="acc-p-preorder" role="region" aria-labelledby="acc-preorder" hidden style="height:0">
              <div class="rte">{% render 'preorder-notice', product: p %}</div>
            </div>
          </div>

          <div class="accordion__item">
            <h3>
              <button class="accordion__trigger" id="acc-returns" aria-expanded="false" aria-controls="acc-p-returns">
                <span>Returns</span>{% render 'icon', name: 'plus' %}
              </button>
            </h3>
            <div class="accordion__panel" id="acc-p-returns" role="region" aria-labelledby="acc-returns" hidden style="height:0">
              <div class="rte"><p>Because supplements are ingestible goods, opened products cannot be returned unless defective, damaged, incorrect, or otherwise required by law. Contact support for return help.</p></div>
            </div>
          </div>
        </div>

        {% render 'supplement-disclaimer', compact: true %}
      </div>
    </div>

    {%- comment -%} Full REÚ range — only this brand’s products {%- endcomment -%}
    {%- liquid
      assign range_col = collections['pouch-collection']
      if range_col == blank
        assign range_col = collections.pouches
      endif
      assign range_col_b = collections['sachet-collection']
      if range_col_b == blank
        assign range_col_b = collections.sachets
      endif
      assign shown_ids = ',' | append: p.id | append: ','
    -%}
    <div class="reu-pdp-range">
      <div class="reu-pdp-range__head">
        <div>
          <h2>Shop the REÚ range</h2>
          <p>Every pouch and sachet in the collection — same Soxa-inspired product presentation, only REÚ products.</p>
        </div>
        <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">Shop All <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
      </div>
      <div class="reu-pdp-range__grid" role="list">
        {%- if range_col != blank -%}
          {%- for product in range_col.products -%}
            {%- assign id_token = ',' | append: product.id | append: ',' -%}
            {%- unless shown_ids contains id_token -%}
              {%- assign shown_ids = shown_ids | append: product.id | append: ',' -%}
              {% render 'reu-pdp-card', product: product, cta_label: 'View product →' %}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if range_col_b != blank -%}
          {%- for product in range_col_b.products -%}
            {%- assign id_token = ',' | append: product.id | append: ',' -%}
            {%- unless shown_ids contains id_token -%}
              {%- assign shown_ids = shown_ids | append: product.id | append: ',' -%}
              {% render 'reu-pdp-card', product: product, cta_label: 'View product →' %}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if range_col == blank and range_col_b == blank -%}
          {%- for product in collections.all.products limit: 18 -%}
            {%- if product.id == p.id -%}{% continue %}{%- endif -%}
            {% render 'reu-pdp-card', product: product, cta_label: 'View product →' %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>{{ p | json }}</script>
</section>

<div class="sticky-bar" data-sticky-bar>
  <div class="sticky-bar__img">
    {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 88 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
  </div>
  <div class="sticky-bar__info">
    <div class="sticky-bar__title">{{ p.title }}</div>
    <div class="sticky-bar__meta"><span data-price>{{ current.price | money }}</span>{%- unless p.has_only_default_variant %} · <span data-sticky-variant>{{ current.title }}</span>{% endunless -%}</div>
  </div>
  <button type="button" class="btn" onclick="document.querySelector('[data-product-form] [data-add-btn]').click()" {% unless current.available %}disabled{% endunless %}>
    {%- if preorder -%}{{ 'products.product.preorder' | t }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
  </button>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ p.title | json }},
  "description": {% if show_description %}{{ desc_plain | truncatewords: 60 | json }}{% else %}{{ p.title | json }}{% endif %},
  "image": [{% for media in p.media limit: 3 %}{{ media | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  {% if p.vendor != blank %}"brand": { "@type": "Brand", "name": {{ p.vendor | json }} },{% endif %}
  "offers": {
    "@type": "Offer",
    "price": "{{ current.price | divided_by: 100.0 }}",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "https://schema.org/{% if p.available %}{% if preorder %}PreOrder{% else %}InStock{% endif %}{% else %}OutOfStock{% endif %}",
    "url": {{ shop.url | append: p.url | json }}
    {% if current.sku != blank %}, "sku": {{ current.sku | json }}{% endif %}
  }
  {%- if p.metafields.reviews.rating.value != blank -%},
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "{{ p.metafields.reviews.rating.value.rating }}", "reviewCount": "{{ p.metafields.reviews.rating_count.value | default: 0 }}" }
  {%- endif -%}
}
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    { "type": "paragraph", "content": "Soxa-inspired REÚ product layout. Copy uses product metafields; blueprint short descriptions fill gaps by product handle." }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
