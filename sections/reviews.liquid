<section class="section bg-blush">
  <div class="wrap">
    <div class="section-head" style="max-width:36rem">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | newline_to_br }}</h2>
    </div>
    <div class="reviews-split">
      <div class="reviews-split__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '700,1000,1400', sizes: '(min-width:990px) 45vw, 100vw', loading: 'lazy', alt: section.settings.heading | escape }}
        {%- else -%}
          <img src="{{ 'reu-protein-chocolate.jpg' | asset_url }}" width="2000" height="1333" alt="" loading="lazy">
        {%- endif -%}
      </div>
      <div>
        {%- assign has_quotes = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'quote' and block.settings.quote != blank -%}{%- assign has_quotes = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_quotes -%}
          <div class="reviews-grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'quote' and block.settings.quote != blank -%}
                <article class="review-card" {{ block.shopify_attributes }}>
                  <p class="review-card__quote">{{ block.settings.quote }}</p>
                  <div class="review-card__person">
                    {%- if block.settings.avatar != blank -%}
                      <div class="review-card__avatar">{{ block.settings.avatar | image_url: width: 96 | image_tag: loading: 'lazy', alt: block.settings.name | escape }}</div>
                    {%- endif -%}
                    <div>
                      <strong>{{ block.settings.name }}</strong>
                      {%- if block.settings.detail != blank -%}<div class="text-muted" style="font-size:.85rem">{{ block.settings.detail }}</div>{%- endif -%}
                    </div>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="reviews-launch">
            <p class="h3">{{ section.settings.launch_heading | default: 'Be among the first to experience REÚ.' }}</p>
            <p class="lede">{{ section.settings.launch_copy }}</p>
            {%- if section.settings.cta_label != blank -%}
              <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
            {%- endif -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}<div {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real REÚ routines" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Real experiences from\nwomen building wellness\ntheir way." },
    { "type": "image_picker", "id": "image", "label": "Lifestyle image" },
    { "type": "text", "id": "launch_heading", "label": "Launch heading", "default": "Be among the first to experience REÚ." },
    { "type": "textarea", "id": "launch_copy", "label": "Launch copy", "default": "Reserve your products from our first release and be one of the first women to make REÚ part of your routine." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Pre-Order" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    { "type": "quote", "name": "Testimonial", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "detail", "label": "Detail" },
      { "type": "image_picker", "id": "avatar", "label": "Photo (optional, genuine only)" }
    ]},
    { "type": "@app" }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
