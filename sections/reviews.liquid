<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      {%- comment -%} App blocks (real review apps) render here. No fabricated testimonials. {%- endcomment -%}
      <div class="grid cols-3">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} Launch state before verified reviews exist {%- endcomment -%}
      <div class="text-center">
        <p class="h3" style="max-width:36rem;margin-inline:auto">{{ section.settings.launch_copy }}</p>
        {%- if section.settings.cta_label != blank -%}
          <div style="margin-top:1.5rem"><a class="btn" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
        {%- endif -%}
        {%- if request.design_mode -%}
          <p class="form-note" style="margin-top:1rem">Add a review app block here once verified reviews are collected. This launch message is shown until then.</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by women building wellness their way" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Real routines. Real experiences. Real reasons to come back." },
    { "type": "textarea", "id": "launch_copy", "label": "Launch-state copy (before real reviews)", "default": "Be among the first to experience REÚ." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Pre-Order" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-blush", "label": "Blush" }, { "value": "bg-cream", "label": "Cream" }
    ], "default": "bg-blush" }
  ],
  "blocks": [ { "type": "@app" } ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
