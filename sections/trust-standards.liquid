<section
  class="standards section"
  aria-labelledby="StandardsHeading-{{ section.id }}"
>
  <div class="wrap standards__layout">
    <div class="standards__visual">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '640,960,1200,1600',
            sizes: '(min-width: 990px) 42vw, 92vw',
            loading: 'lazy',
            alt: section.settings.heading | escape
        }}
      {%- else -%}
        <img
          src="{{ 'reu-standard-visual.jpg' | asset_url }}"
          width="2048"
          height="1364"
          alt="{{ section.settings.heading | default: 'REÚ Greens Pineapple pouch and sachet' | escape }}"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>

    <div class="standards__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="standards__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="standards__heading" id="StandardsHeading-{{ section.id }}">
        {{ section.settings.heading | newline_to_br }}
      </h2>
      {%- if section.settings.body != blank -%}
        <p class="standards__body">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="standards-grid">
          {%- for block in section.blocks -%}
            <div class="standard-item" {{ block.shopify_attributes }}>
              <div class="standard-item__icon" aria-hidden="true">
                {% render 'icon', name: block.settings.icon %}
              </div>
              <span>{{ block.settings.title }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust standards",
  "tag": "section",
  "class": "section-trust-standards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The REÚ Standard"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "What belongs in your routine\nshould never be a mystery."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "We believe confidence starts with clarity. Every REÚ product clearly explains what is inside, how to use it, and what to expect—using verified product information only."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    }
  ],
  "blocks": [
    {
      "type": "standard",
      "name": "Standard",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "sun", "label": "Sun" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clearly Listed Ingredients"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust standards",
      "blocks": [
        { "type": "standard", "settings": { "icon": "check", "title": "Clearly Listed Ingredients" } },
        { "type": "standard", "settings": { "icon": "sparkle", "title": "Easy-to-Follow Directions" } },
        { "type": "standard", "settings": { "icon": "shield", "title": "Transparent Product Information" } },
        { "type": "standard", "settings": { "icon": "leaf", "title": "Thoughtfully Created" } },
        { "type": "standard", "settings": { "icon": "heart", "title": "Great-Tasting Formats" } },
        { "type": "standard", "settings": { "icon": "sun", "title": "Designed for Everyday Routines" } }
      ]
    }
  ]
}
{% endschema %}
