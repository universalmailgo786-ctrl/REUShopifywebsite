<section
  class="standards section {{ section.settings.bg_scheme }}"
  aria-labelledby="StandardsHeading-{{ section.id }}"
>
  <div class="wrap standards__layout">
    <div class="standards__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="standards__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="standards__heading" id="StandardsHeading-{{ section.id }}">
        {{ section.settings.heading | newline_to_br }}
      </h2>
      {%- if section.settings.body != blank -%}
        <p class="standards__body">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="standards-grid">
          {%- for block in section.blocks -%}
            <div class="standard-item" {{ block.shopify_attributes }}>
              <div class="standard-item__icon" aria-hidden="true">
                {% render 'icon', name: block.settings.icon %}
              </div>
              <span>{{ block.settings.title }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="standards__visual">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '640,960,1200,1600',
            sizes: '(min-width: 990px) 42vw, 92vw',
            loading: 'lazy',
            alt: section.settings.image_alt | default: section.settings.heading | escape
        }}
      {%- else -%}
        <img
          src="{{ section.settings.fallback_asset | default: 'reu-standards-clarity.jpg' | asset_url }}"
          width="682"
          height="1024"
          alt="{{ section.settings.image_alt | default: 'Woman preparing a REÚ Hydration Electrolytes drink on a court' | escape }}"
          loading="lazy"
          decoding="async"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust standards",
  "tag": "section",
  "class": "section-trust-standards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The REÚ Standard"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "What belongs in your routine\nshould never be a mystery."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Confidence starts with clarity. Every product page clearly explains what is inside, how to use it and what to expect—using supplier-verified information only."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Fallback asset filename",
      "default": "reu-standards-clarity.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Woman preparing a REÚ Hydration Electrolytes drink on a court"
    },
    {
      "type": "select",
      "id": "bg_scheme",
      "label": "Background",
      "options": [
        { "value": "bg-cream", "label": "Cream" },
        { "value": "bg-sage", "label": "Sage" }
      ],
      "default": "bg-cream"
    }
  ],
  "blocks": [
    {
      "type": "standard",
      "name": "Standard",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "sun", "label": "Sun" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clearly listed ingredients"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust standards",
      "blocks": [
        { "type": "standard", "settings": { "icon": "check", "title": "Clearly listed ingredients" } },
        { "type": "standard", "settings": { "icon": "sparkle", "title": "Easy-to-follow directions" } },
        { "type": "standard", "settings": { "icon": "shield", "title": "Transparent product information" } },
        { "type": "standard", "settings": { "icon": "leaf", "title": "Thoughtfully created formats" } },
        { "type": "standard", "settings": { "icon": "heart", "title": "Great-tasting options" } },
        { "type": "standard", "settings": { "icon": "sun", "title": "Designed for everyday routines" } }
      ]
    }
  ]
}
{% endschema %}
