{%- comment -%} Container for a real review app block on the product page. {%- endcomment -%}
<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap wrap--narrow">
    {%- if section.blocks.size > 0 -%}
      {%- if section.settings.heading != blank -%}<h2 class="h3" style="margin-bottom:1rem">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- for block in section.blocks -%}<div {{ block.shopify_attributes }}>{% render block %}</div>{%- endfor -%}
    {%- elsif request.design_mode -%}
      <p class="notice">Add your review app block here (e.g. Judge.me, Loox, Shopify Product Reviews). No placeholder reviews are shown.</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews (app)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-blush", "label": "Blush" }
    ], "default": "" }
  ],
  "blocks": [ { "type": "@app" } ],
  "presets": [{ "name": "Reviews (app)" }]
}
{% endschema %}
