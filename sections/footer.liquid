{%- liquid
  assign menu_shop = section.settings.menu_shop
  assign menu_discover = section.settings.menu_discover
  assign menu_care = section.settings.menu_care
  assign support_email = section.settings.support_email | default: settings.support_email
  assign ig = settings.social_instagram | default: '#'
  assign tt = settings.social_tiktok | default: '#'
  assign fb = settings.social_facebook | default: '#'
  assign yt = settings.social_youtube | default: '#'
-%}
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 320 | image_tag: widths: '160,240,320', alt: shop.name, loading: 'lazy' }}
          {%- else -%}
            <img src="{{ 'reu-logo.png' | asset_url }}" width="1817" height="1001" alt="{{ shop.name }}" loading="lazy">
          {%- endif -%}
        </a>
        <p class="site-footer__statement">{{ section.settings.statement }}</p>
        {%- if support_email != blank or section.settings.support_hours != blank -%}
          <p class="text-muted" style="color:rgba(255,255,255,.7);font-size:.92rem;margin-top:1rem">
            {%- if support_email != blank -%}<a href="mailto:{{ support_email }}">{{ support_email }}</a><br>{%- endif -%}
            {%- if section.settings.support_hours != blank -%}{{ section.settings.support_hours }}{%- endif -%}
          </p>
        {%- endif -%}
      </div>

      <div class="site-footer__col">
        <h3>{{ section.settings.shop_heading }}</h3>
        {%- if menu_shop != blank -%}
          {%- for link in menu_shop.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Shop All</a>
          <a href="{{ routes.collections_url }}/pouch-collection">Pouch Collection</a>
          <a href="{{ routes.collections_url }}/sachet-collection">Sachet Collection</a>
          <a href="{{ routes.root_url }}pages/quiz">Take the Quiz</a>
        {%- endif -%}
      </div>

      <div class="site-footer__col">
        <h3>{{ section.settings.discover_heading }}</h3>
        {%- if menu_discover != blank -%}
          {%- for link in menu_discover.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- else -%}
          <a href="{{ routes.root_url }}pages/about-us">About REÚ</a>
          <a href="{{ routes.root_url }}blogs/news">The REÚ Journal</a>
          <a href="{{ routes.root_url }}pages/faq">FAQ</a>
          <a href="{{ routes.root_url }}pages/contact">Contact Us</a>
        {%- endif -%}
      </div>

      <div class="site-footer__col">
        <h3>{{ section.settings.care_heading }}</h3>
        {%- if menu_care != blank -%}
          {%- for link in menu_care.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- else -%}
          <a href="{{ routes.root_url }}pages/pre-order-information">Pre-Order Information</a>
          <a href="{{ routes.root_url }}policies/shipping-policy">Shipping Policy</a>
          <a href="{{ routes.root_url }}policies/refund-policy">Refund Policy</a>
          <a href="{{ routes.root_url }}policies/privacy-policy">Privacy Policy</a>
          <a href="{{ routes.root_url }}policies/terms-of-service">Terms &amp; Conditions</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="site-footer__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.tagline }}</p>
      <div class="site-footer__social">
        <a href="{{ ig }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
        <a href="{{ tt }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
        <a href="{{ fb }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
        <a href="{{ yt }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>
      </div>
      {%- if section.settings.show_payment_icons -%}
        <div class="payment-icons">{{ shop.enabled_payment_types | payment_type_svg_tag }}</div>
      {%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "statement", "label": "Brand statement", "default": "Premium wellness made simple, enjoyable, and designed around women. Live Better. Every Day." },
    { "type": "text", "id": "tagline", "label": "Tagline line", "default": "Live Better. Every Day." },
    { "type": "text", "id": "shop_heading", "label": "Shop column heading", "default": "Shop" },
    { "type": "link_list", "id": "menu_shop", "label": "Shop menu", "default": "footer-shop" },
    { "type": "text", "id": "discover_heading", "label": "Discover column heading", "default": "Discover" },
    { "type": "link_list", "id": "menu_discover", "label": "Discover menu", "default": "footer-learn" },
    { "type": "text", "id": "care_heading", "label": "Customer care heading", "default": "Customer Care" },
    { "type": "link_list", "id": "menu_care", "label": "Customer care menu", "default": "footer-support" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "hello@livewithreu.com" },
    { "type": "text", "id": "support_hours", "label": "Support hours", "default": "Mon–Fri, 9am–5pm EST" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Information on this website is provided for general educational purposes and is not medical advice. Always follow the product label and consult a qualified healthcare professional when appropriate." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ]
}
{% endschema %}
