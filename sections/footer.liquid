{%- liquid
  assign menu_shop = section.settings.menu_shop
  assign menu_discover = section.settings.menu_discover
  assign menu_care = section.settings.menu_care
  assign support_email = section.settings.support_email | default: settings.support_email
  assign support_phone = section.settings.support_phone
  assign help_label = section.settings.help_label | default: 'Help Center'
  assign help_link = section.settings.help_link
  if help_link == blank
    assign help_link = pages.faq.url | default: '/pages/faq'
  endif
  assign ig = settings.social_instagram
  assign tt = settings.social_tiktok
  assign fb = settings.social_facebook
  assign yt = settings.social_youtube

  assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign refund_url = shop.refund_policy.url | default: '/policies/refund-policy'
  assign shipping_url = shop.shipping_policy.url | default: '/policies/shipping-policy'
  assign terms_url = shop.terms_of_service.url | default: '/policies/terms-of-service'

  assign about_url = pages['about-reu'].url | default: pages.about.url | default: '/pages/about-reu'
  assign contact_url = pages.contact.url | default: '/pages/contact'
  assign faq_url = pages.faq.url | default: '/pages/faq'
  assign quiz_url = pages['find-your-reu'].url | default: pages.quiz.url | default: '/pages/find-your-reu'
  assign collections_url = pages.collections.url | default: '/pages/collections'
  assign products_url = pages.products.url | default: routes.all_products_collection_url
  assign journal_url = blogs.journal.url | default: blogs.news.url | default: '/blogs/journal'
  assign pouches_url = collections.pouches.url | default: collections['pouch-collection'].url | default: '/collections/pouches'
  assign sachets_url = collections.sachets.url | default: collections['sachet-collection'].url | default: '/collections/sachets'
-%}
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <a class="site-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 360 | image_tag: widths: '180,240,320,360', alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <img src="{{ 'reu-logo.png' | asset_url }}" width="1817" height="1001" alt="{{ shop.name }}" loading="lazy">
        {%- endif -%}
      </a>

      <div class="site-footer__contact">
        <p class="site-footer__label">{{ section.settings.contact_heading | default: 'Contact us' }}</p>
        {%- if support_phone != blank -%}
          <a class="site-footer__phone" href="tel:{{ support_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}">{{ support_phone }}</a>
        {%- endif -%}
        {%- if support_email != blank -%}
          <a class="site-footer__email" href="mailto:{{ support_email }}">{{ support_email }}</a>
        {%- endif -%}
        {%- if help_label != blank -%}
          <a class="site-footer__help" href="{{ help_link }}">
            {{ help_label }}
            <span class="site-footer__help-icon" aria-hidden="true">{% render 'icon', name: 'arrow-up-right' %}</span>
          </a>
        {%- endif -%}
        <a class="site-footer__help" href="{{ contact_url }}" style="margin-top:.55rem">Contact page</a>
      </div>

      {%- comment -%} Discover {%- endcomment -%}
      <nav class="site-footer__nav" aria-label="{{ section.settings.discover_heading | default: 'Discover' }}">
        <p class="site-footer__label">{{ section.settings.discover_heading | default: 'Discover' }}</p>
        {%- if menu_discover != blank and menu_discover.links.size > 0 -%}
          {%- for link in menu_discover.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
        {%- liquid
          assign discover_blob = ''
          if menu_discover != blank
            for link in menu_discover.links
              assign discover_blob = discover_blob | append: link.url | append: '|' | append: link.title | downcase | append: '||'
            endfor
          endif
        -%}
        {%- unless discover_blob contains about_url or discover_blob contains 'about' -%}
          <a href="{{ about_url }}">About REÚ</a>
        {%- endunless -%}
        {%- unless discover_blob contains journal_url or discover_blob contains 'journal' -%}
          <a href="{{ journal_url }}">The REÚ Journal</a>
        {%- endunless -%}
        {%- unless discover_blob contains faq_url or discover_blob contains 'faq' -%}
          <a href="{{ faq_url }}">FAQs</a>
        {%- endunless -%}
        {%- unless discover_blob contains quiz_url or discover_blob contains 'quiz' or discover_blob contains 'find-your' -%}
          <a href="{{ quiz_url }}">Find Your REÚ</a>
        {%- endunless -%}
        {%- unless discover_blob contains contact_url or discover_blob contains 'contact' -%}
          <a href="{{ contact_url }}">Contact us</a>
        {%- endunless -%}
      </nav>

      {%- comment -%} Shop {%- endcomment -%}
      <nav class="site-footer__nav" aria-label="{{ section.settings.shop_heading | default: 'Shop' }}">
        <p class="site-footer__label">{{ section.settings.shop_heading | default: 'Shop' }}</p>
        {%- if menu_shop != blank and menu_shop.links.size > 0 -%}
          {%- for link in menu_shop.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
        {%- liquid
          assign shop_blob = ''
          if menu_shop != blank
            for link in menu_shop.links
              assign shop_blob = shop_blob | append: link.url | append: '|' | append: link.title | downcase | append: '||'
            endfor
          endif
        -%}
        {%- unless shop_blob contains '/collections/all' or shop_blob contains 'shop all' -%}
          <a href="{{ routes.all_products_collection_url }}">Shop All</a>
        {%- endunless -%}
        {%- unless shop_blob contains products_url or shop_blob contains 'products' -%}
          <a href="{{ products_url }}">Products</a>
        {%- endunless -%}
        {%- unless shop_blob contains collections_url or shop_blob contains 'collections' -%}
          <a href="{{ collections_url }}">Collections</a>
        {%- endunless -%}
        {%- unless shop_blob contains pouches_url or shop_blob contains 'pouch' -%}
          <a href="{{ pouches_url }}">Pouch Collection</a>
        {%- endunless -%}
        {%- unless shop_blob contains sachets_url or shop_blob contains 'sachet' -%}
          <a href="{{ sachets_url }}">Sachet Collection</a>
        {%- endunless -%}
        {%- unless shop_blob contains quiz_url or shop_blob contains 'quiz' -%}
          <a href="{{ quiz_url }}">Take the Quiz</a>
        {%- endunless -%}
      </nav>

      {%- comment -%} Policies / Customer care — always complete {%- endcomment -%}
      <nav class="site-footer__nav" aria-label="{{ section.settings.care_heading | default: 'Policies' }}">
        <p class="site-footer__label">{{ section.settings.care_heading | default: 'Policies' }}</p>
        {%- if menu_care != blank and menu_care.links.size > 0 -%}
          {%- for link in menu_care.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
        {%- liquid
          assign care_blob = ''
          if menu_care != blank
            for link in menu_care.links
              assign care_blob = care_blob | append: link.url | append: '|' | append: link.title | downcase | append: '||'
            endfor
          endif
        -%}
        {%- unless care_blob contains 'privacy' or care_blob contains privacy_url -%}
          <a href="{{ privacy_url }}">{{ shop.privacy_policy.title | default: 'Privacy Policy' }}</a>
        {%- endunless -%}
        {%- unless care_blob contains 'refund' or care_blob contains 'return' or care_blob contains 'cancel' or care_blob contains refund_url -%}
          <a href="{{ refund_url }}">{{ shop.refund_policy.title | default: 'Refund & Cancellation Policy' }}</a>
        {%- endunless -%}
        {%- unless care_blob contains 'shipping' or care_blob contains shipping_url -%}
          <a href="{{ shipping_url }}">{{ shop.shipping_policy.title | default: 'Shipping & Pre-Order Policy' }}</a>
        {%- endunless -%}
        {%- unless care_blob contains 'terms' or care_blob contains terms_url -%}
          <a href="{{ terms_url }}">{{ shop.terms_of_service.title | default: 'Terms & Conditions' }}</a>
        {%- endunless -%}
        {%- unless care_blob contains faq_url or care_blob contains 'faq' -%}
          <a href="{{ faq_url }}">FAQs</a>
        {%- endunless -%}
        {%- unless care_blob contains contact_url or care_blob contains 'contact' -%}
          <a href="{{ contact_url }}">Contact</a>
        {%- endunless -%}
      </nav>
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="site-footer__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

    <div class="site-footer__bottom">
      <p class="site-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.tagline }}</p>

      <div class="site-footer__social">
        {%- if fb != blank -%}
          <a href="{{ fb }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}</a>
        {%- endif -%}
        {%- if ig != blank -%}
          <a href="{{ ig }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}</a>
        {%- endif -%}
        {%- if tt != blank -%}
          <a href="{{ tt }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}</a>
        {%- endif -%}
        {%- if yt != blank -%}
          <a href="{{ yt }}" aria-label="YouTube" target="_blank" rel="noopener">{% render 'icon', name: 'youtube' %}</a>
        {%- endif -%}
        {%- if fb == blank and ig == blank and tt == blank and yt == blank -%}
          <a href="{{ contact_url }}" aria-label="Contact">{% render 'icon', name: 'mail' %}</a>
          <a href="{{ faq_url }}" aria-label="FAQ">{% render 'icon', name: 'sparkle' %}</a>
        {%- endif -%}
      </div>

      <nav class="site-footer__legal" aria-label="Legal">
        <a href="{{ privacy_url }}">Privacy Policy</a>
        <a href="{{ refund_url }}">Refunds</a>
        <a href="{{ shipping_url }}">Shipping</a>
        <a href="{{ terms_url }}">Terms &amp; Conditions</a>
        <a href="{{ contact_url }}">Contact</a>
      </nav>

      <a class="site-footer__totop" href="#MainContent" aria-label="Back to top">
        {% render 'icon', name: 'chevron-up' %}
      </a>
    </div>

    <p class="site-footer__credit">
      Designed by
      <a href="https://www.owlisticstudio.com" target="_blank" rel="noopener noreferrer">Owlistic Studio</a>
    </p>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline line", "default": "Live Better. Every Day." },
    { "type": "text", "id": "contact_heading", "label": "Contact heading", "default": "Contact us" },
    { "type": "text", "id": "support_phone", "label": "Support phone" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "hello@livewithreu.com" },
    { "type": "text", "id": "help_label", "label": "Help link label", "default": "Help Center" },
    { "type": "url", "id": "help_link", "label": "Help link" },
    { "type": "text", "id": "shop_heading", "label": "Shop column label", "default": "Shop" },
    { "type": "link_list", "id": "menu_shop", "label": "Shop menu", "info": "Optional. Missing core shop links are added automatically." },
    { "type": "text", "id": "discover_heading", "label": "Discover column label", "default": "Discover" },
    { "type": "link_list", "id": "menu_discover", "label": "Discover menu", "info": "Optional. Missing core discover links are added automatically." },
    { "type": "text", "id": "care_heading", "label": "Policies column label", "default": "Policies" },
    { "type": "link_list", "id": "menu_care", "label": "Policies / customer care menu", "info": "Optional. Privacy, Refunds, Shipping and Terms are always shown." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Information on this website is provided for general educational purposes and is not medical advice. Always follow the product label and consult a qualified healthcare professional when appropriate." }
  ]
}
{% endschema %}
