{%- liquid
  assign menu_shop = section.settings.menu_shop
  assign menu_discover = section.settings.menu_discover
  assign menu_care = section.settings.menu_care
  assign support_email = section.settings.support_email | default: settings.support_email
  assign support_phone = section.settings.support_phone
  assign help_label = section.settings.help_label
  assign help_link = section.settings.help_link

  assign ig = settings.social_instagram
  assign tt = settings.social_tiktok
  assign fb = settings.social_facebook
  assign yt = settings.social_youtube

  assign privacy = shop.privacy_policy
  assign refund = shop.refund_policy
  assign shipping = shop.shipping_policy
  assign terms = shop.terms_of_service

  assign privacy_url = privacy.url | default: '/policies/privacy-policy'
  assign refund_url = refund.url | default: '/policies/refund-policy'
  assign shipping_url = shipping.url | default: '/policies/shipping-policy'
  assign terms_url = terms.url | default: '/policies/terms-of-service'

  assign about_page = pages['about-reu']
  if about_page == blank
    assign about_page = pages.about
  endif
  assign contact_page = pages.contact
  assign faq_page = pages.faq
  assign quiz_page = pages['find-your-reu']
  if quiz_page == blank
    assign quiz_page = pages.quiz
  endif
  assign collections_page = pages.collections
  assign products_page = pages.products
  assign journal_blog = blogs.journal
  if journal_blog == blank
    assign journal_blog = blogs.news
  endif

  assign pouch_col = collections['pouch-collection']
  if pouch_col == blank
    assign pouch_col = collections.pouches
  endif
  assign sachet_col = collections['sachet-collection']
  if sachet_col == blank
    assign sachet_col = collections.sachets
  endif

  if help_link == blank and faq_page != blank
    assign help_link = faq_page.url
  endif
  if help_link == blank
    assign help_label = blank
  endif
-%}
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <a class="site-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 360 | image_tag: widths: '180,240,320,360', alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <img src="{{ 'reu-logo.png' | asset_url }}" width="1817" height="1001" alt="{{ shop.name }}" loading="lazy">
        {%- endif -%}
      </a>

      <div class="site-footer__contact">
        <p class="site-footer__label">{{ section.settings.contact_heading | default: 'Contact us' }}</p>
        {%- if support_phone != blank -%}
          <a class="site-footer__phone" href="tel:{{ support_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}">{{ support_phone }}</a>
        {%- endif -%}
        {%- if support_email != blank -%}
          <a class="site-footer__email" href="mailto:{{ support_email }}">{{ support_email }}</a>
        {%- endif -%}
        {%- if help_label != blank and help_link != blank -%}
          <a class="site-footer__help" href="{{ help_link }}">
            {{ help_label }}
            <span class="site-footer__help-icon" aria-hidden="true">{% render 'icon', name: 'arrow-up-right' %}</span>
          </a>
        {%- endif -%}
        {%- if contact_page != blank -%}
          <a class="site-footer__help" href="{{ contact_page.url }}" style="margin-top:.55rem">{{ contact_page.title }}</a>
        {%- endif -%}
      </div>

      <nav class="site-footer__nav" aria-label="{{ section.settings.discover_heading | default: 'Discover' }}">
        <p class="site-footer__label">{{ section.settings.discover_heading | default: 'Discover' }}</p>
        {%- if menu_discover != blank and menu_discover.links.size > 0 -%}
          {%- for link in menu_discover.links -%}
            {%- if link.url != blank and link.url != '#' -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- if about_page != blank -%}<a href="{{ about_page.url }}">{{ about_page.title }}</a>{%- endif -%}
          {%- if journal_blog != blank -%}<a href="{{ journal_blog.url }}">The REÚ Journal</a>{%- endif -%}
          {%- if faq_page != blank -%}<a href="{{ faq_page.url }}">{{ faq_page.title }}</a>{%- endif -%}
          {%- if quiz_page != blank -%}<a href="{{ quiz_page.url }}">{{ quiz_page.title }}</a>{%- endif -%}
          {%- if contact_page != blank -%}<a href="{{ contact_page.url }}">{{ contact_page.title }}</a>{%- endif -%}
        {%- endif -%}
      </nav>

      <nav class="site-footer__nav" aria-label="{{ section.settings.shop_heading | default: 'Shop' }}">
        <p class="site-footer__label">{{ section.settings.shop_heading | default: 'Shop' }}</p>
        {%- if menu_shop != blank and menu_shop.links.size > 0 -%}
          {%- for link in menu_shop.links -%}
            {%- if link.url != blank and link.url != '#' -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Shop All</a>
          {%- if products_page != blank -%}<a href="{{ products_page.url }}">{{ products_page.title }}</a>{%- endif -%}
          {%- if collections_page != blank -%}<a href="{{ collections_page.url }}">{{ collections_page.title }}</a>{%- endif -%}
          {%- if pouch_col != blank -%}<a href="{{ pouch_col.url }}">{{ pouch_col.title }}</a>{%- endif -%}
          {%- if sachet_col != blank -%}<a href="{{ sachet_col.url }}">{{ sachet_col.title }}</a>{%- endif -%}
          {%- if quiz_page != blank -%}<a href="{{ quiz_page.url }}">Take the Quiz</a>{%- endif -%}
        {%- endif -%}
      </nav>

      <nav class="site-footer__nav" aria-label="{{ section.settings.care_heading | default: 'Policies' }}">
        <p class="site-footer__label">{{ section.settings.care_heading | default: 'Policies' }}</p>
        {%- if menu_care != blank and menu_care.links.size > 0 -%}
          {%- for link in menu_care.links -%}
            {%- if link.url != blank and link.url != '#' -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <a href="{{ privacy_url }}">Privacy Policy</a>
          <a href="{{ refund_url }}">Refund &amp; Cancellation Policy</a>
          <a href="{{ shipping_url }}">Shipping &amp; Pre-Order Policy</a>
          <a href="{{ terms_url }}">Terms &amp; Conditions</a>
          {%- if faq_page != blank -%}<a href="{{ faq_page.url }}">{{ faq_page.title }}</a>{%- endif -%}
          {%- if contact_page != blank -%}<a href="{{ contact_page.url }}">{{ contact_page.title }}</a>{%- endif -%}
        {%- endif -%}
      </nav>
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="site-footer__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

    <div class="site-footer__bottom">
      <p class="site-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.tagline }}</p>

      <div class="site-footer__social">
        {%- if fb != blank -%}
          <a href="{{ fb }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}</a>
        {%- endif -%}
        {%- if ig != blank -%}
          <a href="{{ ig }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}</a>
        {%- endif -%}
        {%- if tt != blank -%}
          <a href="{{ tt }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}</a>
        {%- endif -%}
        {%- if yt != blank -%}
          <a href="{{ yt }}" aria-label="YouTube" target="_blank" rel="noopener">{% render 'icon', name: 'youtube' %}</a>
        {%- endif -%}
      </div>

      <nav class="site-footer__legal" aria-label="Legal">
        <a href="{{ privacy_url }}">Privacy Policy</a>
        <a href="{{ refund_url }}">Refund &amp; Cancellation Policy</a>
        <a href="{{ shipping_url }}">Shipping &amp; Pre-Order Policy</a>
        <a href="{{ terms_url }}">Terms &amp; Conditions</a>
        {%- if contact_page != blank -%}<a href="{{ contact_page.url }}">{{ contact_page.title }}</a>{%- endif -%}
      </nav>

      <a class="site-footer__totop" href="#MainContent" aria-label="Back to top">
        {% render 'icon', name: 'chevron-up' %}
      </a>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline line", "default": "Live Better. Every Day." },
    { "type": "text", "id": "contact_heading", "label": "Contact heading", "default": "Contact us" },
    { "type": "text", "id": "support_phone", "label": "Support phone" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "hello@livewithreu.com" },
    { "type": "text", "id": "help_label", "label": "Help link label", "default": "Help Center", "info": "Only shown when Help link points to a real store page (or FAQ exists)." },
    { "type": "url", "id": "help_link", "label": "Help link", "info": "Pick a store page. Leave blank to use FAQ when that page exists." },
    { "type": "text", "id": "shop_heading", "label": "Shop column label", "default": "Shop" },
    { "type": "link_list", "id": "menu_shop", "label": "Shop menu", "info": "Optional. If empty, only existing collections/pages are listed." },
    { "type": "text", "id": "discover_heading", "label": "Discover column label", "default": "Discover" },
    { "type": "link_list", "id": "menu_discover", "label": "Discover menu", "info": "Optional. If empty, only existing pages/blogs are listed." },
    { "type": "text", "id": "care_heading", "label": "Policies column label", "default": "Policies" },
    { "type": "link_list", "id": "menu_care", "label": "Policies menu", "info": "Optional. If empty, only published Shopify policies and existing pages are listed." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Information on this website is provided for general educational purposes and is not medical advice. Always follow the product label and consult a qualified healthcare professional when appropriate." }
  ]
}
{% endschema %}
