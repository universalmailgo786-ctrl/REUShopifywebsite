{%- liquid
  assign desktop = section.settings.image
  assign mobile = section.settings.image_mobile | default: desktop
-%}
<section class="hero">
  <div class="hero__media" aria-hidden="true">
    {%- if desktop != blank -%}
      <picture>
        {%- if mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile | image_url: width: 900 }} 900w, {{ mobile | image_url: width: 1400 }} 1400w">
        {%- endif -%}
        {{ desktop | image_url: width: 2400 | image_tag: widths: '900,1400,1800,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
      </picture>
    {%- else -%}
      <img src="{{ 'reu-hero.jpg' | asset_url }}" width="2000" height="1333" alt="" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h1">{{ section.settings.heading | newline_to_br }}</h1>
      {%- if section.settings.body != blank -%}<div class="lede">{{ section.settings.body }}</div>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--on-dark" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn btn--secondary" style="--btn-fg:#fff;border-color:rgba(255,255,255,.7);background:transparent" href="{{ section.settings.cta2_link | default: routes.root_url }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.disclosure != blank -%}<p class="hero__disclosure">{{ section.settings.disclosure }}</p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wellness that moves with you" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Live Better.\nEvery Day." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Premium, great-tasting supplements created for women who want daily wellness to feel simple, enjoyable, and entirely their own." },
    { "type": "text", "id": "cta_label", "label": "Primary CTA", "default": "Shop Pre-Order" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA", "default": "Find My Routine" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" },
    { "type": "textarea", "id": "disclosure", "label": "Pre-order disclosure", "default": "Available for pre-order. Estimated shipping shown at checkout. Cancel for a full refund any time before shipment." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
