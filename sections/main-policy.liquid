{%- comment -%}
  Native Shopify policy template (/policies/*).
  PolicyDrop exposes title/body/url — not type — so we detect by URL.
  theme-check-disable UndefinedObject
{%- endcomment -%}
{%- liquid
  assign p = policy
  assign contact_url = pages.contact.url | default: '/pages/contact'
  assign last_updated = section.settings.last_updated | default: 'August 4, 2026'
  assign path = request.path | default: '' | downcase
  assign policy_url = p.url | default: path | downcase
  assign policy_type = ''

  if path contains 'privacy-policy' or policy_url contains 'privacy-policy'
    assign policy_type = 'privacy_policy'
  elsif path contains 'refund-policy' or policy_url contains 'refund-policy'
    assign policy_type = 'refund_policy'
  elsif path contains 'shipping-policy' or policy_url contains 'shipping-policy'
    assign policy_type = 'shipping_policy'
  elsif path contains 'terms-of-service' or policy_url contains 'terms-of-service'
    assign policy_type = 'terms_of_service'
  elsif shop.privacy_policy != blank and p.id == shop.privacy_policy.id
    assign policy_type = 'privacy_policy'
  elsif shop.refund_policy != blank and p.id == shop.refund_policy.id
    assign policy_type = 'refund_policy'
  elsif shop.shipping_policy != blank and p.id == shop.shipping_policy.id
    assign policy_type = 'shipping_policy'
  elsif shop.terms_of_service != blank and p.id == shop.terms_of_service.id
    assign policy_type = 'terms_of_service'
  endif

  case policy_type
    when 'privacy_policy'
      assign eyebrow = 'YOUR PRIVACY'
      assign page_title = 'Privacy Policy'
      assign intro = 'Your trust matters to us. This Privacy Policy explains how REÚ collects, uses, shares and protects information when you browse our website, place an order, join our email list, contact us or use our Product Recommendation Quiz.'
      assign cta_label = 'Contact REÚ'
      assign fallback_asset = section.settings.privacy_fallback | default: 'reu-contact-hero.jpg'
    when 'refund_policy'
      assign eyebrow = 'RETURNS & SUPPORT'
      assign page_title = 'Refund & Cancellation Policy'
      assign intro = 'We want every REÚ customer to understand their options clearly. This policy explains pre-order cancellations, eligible returns, damaged products and refunds.'
      assign cta_label = 'Request Support'
      assign fallback_asset = section.settings.refund_fallback | default: 'reu-faq-banner.jpg'
    when 'shipping_policy'
      assign eyebrow = 'ORDER INFORMATION'
      assign page_title = 'Shipping & Pre-Order Policy'
      assign intro = 'REÚ will launch selected products through pre-order. This policy explains availability, payment, estimated shipping, delays and delivery expectations.'
      assign cta_label = 'Contact Our Support Team'
      assign fallback_asset = section.settings.shipping_fallback | default: 'reu-collections-banner.jpg'
    when 'terms_of_service'
      assign eyebrow = 'STORE TERMS'
      assign page_title = 'Terms & Conditions'
      assign intro = 'These Terms govern the use of the REÚ website and purchases made through our Shopify store. By using the website or placing an order, you agree to these Terms and the policies linked from them.'
      assign cta_label = 'Contact REÚ'
      assign fallback_asset = section.settings.terms_fallback | default: 'reu-quiz-hero.jpg'
    else
      assign eyebrow = 'POLICIES'
      assign page_title = p.title | default: 'Store policy'
      assign intro = p.body | strip_html | truncate: 180
      assign cta_label = 'Contact REÚ'
      assign fallback_asset = 'reu-contact-hero.jpg'
  endcase
-%}
<section class="reu-policy" data-policy-type="{{ policy_type }}" data-reu-policy>
  <div class="reu-policy__hero">
    <div class="reu-policy__hero-media" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2800
          | image_tag:
            widths: '900,1400,1800,2400,2800',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      {%- else -%}
        <img
          src="{{ fallback_asset | asset_url }}"
          width="2400"
          height="1000"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- endif -%}
    </div>
    <div class="reu-policy__hero-scrim" aria-hidden="true"></div>
    <div class="reu-policy__hero-inner wrap">
      <nav class="reu-policy__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span>{{ page_title }}</span>
      </nav>
      <p class="eyebrow reu-policy__eyebrow">{{ eyebrow }}</p>
      <h1 class="h1 reu-policy__title">{{ page_title }}</h1>
      <p class="lede reu-policy__intro">{{ intro }}</p>
      <p class="reu-policy__updated">Last updated: {{ last_updated }}</p>
      <p class="reu-policy__legal-note">These drafts must receive jurisdiction-specific legal review before launch.</p>
    </div>
  </div>

  <div class="reu-policy__band">
    <div class="wrap reu-policy__layout">
      {%- if section.settings.show_toc -%}
        <aside class="reu-policy__toc" aria-label="On this page">
          <p class="reu-policy__toc-label">On this page</p>
          <label class="visually-hidden" for="PolicyTocSelect-{{ section.id }}">Jump to section</label>
          <select class="select reu-policy__toc-select" id="PolicyTocSelect-{{ section.id }}" data-policy-toc-select></select>
          <nav class="reu-policy__toc-nav" data-policy-toc-nav></nav>
        </aside>
      {%- endif -%}

      <div class="reu-policy__main">
        <article class="reu-policy__content card" data-policy-content>
          {%- case policy_type -%}
            {%- when 'privacy_policy' -%}
              {% render 'policy-privacy' %}
            {%- when 'refund_policy' -%}
              {% render 'policy-refund' %}
            {%- when 'shipping_policy' -%}
              {% render 'policy-shipping' %}
            {%- when 'terms_of_service' -%}
              {% render 'policy-terms' %}
            {%- else -%}
              {%- if p.body != blank -%}
                <div class="rte">{{ p.body }}</div>
              {%- else -%}
                <div class="reu-policy__section">
                  <h2>Policy unavailable</h2>
                  <p>This policy has not been published yet. Please contact REÚ if you need help.</p>
                </div>
              {%- endif -%}
          {%- endcase -%}
        </article>

        <div class="reu-policy__actions">
          <a class="btn btn--secondary" href="{{ routes.root_url }}">Back to Home</a>
          <a class="btn" href="{{ contact_url }}">{{ cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
        </div>

        {%- if section.settings.show_help -%}
          <aside class="reu-policy__help card">
            <p class="eyebrow">Need help?</p>
            <h2 class="h3">Questions about this policy?</h2>
            <p class="lede" style="margin-top:.65rem">Send us a message and our team will respond during published support hours.</p>
            <div style="margin-top:1.15rem">
              <a class="btn" href="{{ contact_url }}">Contact REÚ <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
            </div>
          </aside>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'reu-policy.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Policy page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image override" },
    { "type": "text", "id": "last_updated", "label": "Last updated label", "default": "August 4, 2026" },
    { "type": "checkbox", "id": "show_toc", "label": "Show table of contents", "default": true },
    { "type": "checkbox", "id": "show_help", "label": "Show Need Help card", "default": true },
    { "type": "text", "id": "privacy_fallback", "label": "Privacy hero asset", "default": "reu-contact-hero.jpg" },
    { "type": "text", "id": "refund_fallback", "label": "Refund hero asset", "default": "reu-faq-banner.jpg" },
    { "type": "text", "id": "shipping_fallback", "label": "Shipping hero asset", "default": "reu-collections-banner.jpg" },
    { "type": "text", "id": "terms_fallback", "label": "Terms hero asset", "default": "reu-quiz-hero.jpg" }
  ]
}
{% endschema %}
