{%- liquid
  assign col = collection
  assign sort_by = col.sort_by | default: col.default_sort_by
  assign handle = col.handle
  assign is_all = false
  if handle == 'all'
    assign is_all = true
  endif
  assign is_pouch = false
  assign is_sachet = false
  if handle == 'pouches' or handle == 'pouch-collection' or handle == 'pouch'
    assign is_pouch = true
  endif
  if handle == 'sachets' or handle == 'sachet-collection' or handle == 'sachet'
    assign is_sachet = true
  endif

  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  if eyebrow == blank
    if is_all
      assign eyebrow = 'SHOP REÚ'
    elsif is_pouch
      assign eyebrow = 'POUCH COLLECTION'
    elsif is_sachet
      assign eyebrow = 'SACHET COLLECTION'
    else
      assign eyebrow = 'SHOP'
    endif
  endif
  if heading == blank
    if is_all
      assign heading = 'Wellness that fits your day.'
    elsif is_pouch
      assign heading = 'Your everyday ritual, ready when you are.'
    elsif is_sachet
      assign heading = 'Your routine, wherever life takes you.'
    else
      assign heading = col.title
    endif
  endif
  if body == blank
    if is_all
      assign body = 'Explore great-tasting daily wellness products created for women. Shop by goal, flavour or format and find the routine that feels right for you.'
    elsif is_pouch
      assign body = 'Explore full-size REÚ favourites created for a consistent, great-tasting wellness routine at home.'
    elsif is_sachet
      assign body = 'Slip a single-serve REÚ sachet into your work bag, gym bag or carry-on and keep your routine moving.'
    else
      assign body = col.description | strip_html
    endif
  endif
-%}
<section class="section collection-page bg-cream" data-collection-handle="{{ handle }}">
  <div class="wrap">
    {% render 'breadcrumbs' %}

    <header class="collection-hero section-head">
      {%- if eyebrow != blank -%}<p class="eyebrow">{{ eyebrow }}</p>{%- endif -%}
      <h1 class="h2">{{ heading }}</h1>
      {%- if body != blank -%}<p class="lede" style="margin-top:.75rem;max-width:42rem">{{ body }}</p>{%- endif -%}

      <div class="collection-hero__ctas" style="display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.25rem">
        {%- if is_all -%}
          <a class="btn" href="{{ pages['find-your-reu'].url | default: pages.quiz.url | default: '/pages/find-your-reu' }}">Find My Routine <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
        {%- elsif is_pouch or is_sachet -%}
          <a class="btn" href="#CollectionGrid">Explore {{ col.title }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
        {%- endif -%}
      </div>
    </header>

    {%- if is_all or section.settings.show_discovery -%}
      <div class="discovery-bar" role="region" aria-label="Shop by goal">
        <p class="discovery-bar__prompt">{{ section.settings.discovery_prompt | default: 'What would you like to support today?' }}</p>
        <div class="discovery-bar__chips" role="list">
          {%- assign goals = 'Hydration|hydration,Beauty & Collagen|beauty-collagen,Daily Wellness|daily-wellness,Greens & Nutrition|greens-nutrition,Energy & Performance|energy-performance,Weight-Management Routine|weight-management,Protein & Recovery|protein-recovery' | split: ',' -%}
          {%- for g in goals -%}
            {%- assign parts = g | split: '|' -%}
            {%- assign goal_col = collections[parts[1]] -%}
            {%- assign href = col.url | append: '?filter.p.m.custom.goal=' | append: parts[0] | url_encode -%}
            {%- if goal_col != blank -%}{%- assign href = goal_col.url -%}{%- endif -%}
            <a class="filter-chip" role="listitem" href="{{ href }}">{{ parts[0] }}</a>
          {%- endfor -%}
          <a class="filter-chip" href="{{ col.url }}">Clear all</a>
        </div>
        <p class="visually-hidden" aria-live="polite" data-filter-announce></p>
      </div>
    {%- endif -%}

    {%- if is_pouch or is_sachet or section.settings.show_benefits -%}
      <ul class="collection-benefits" role="list">
        {%- if is_pouch -%}
          <li><span class="collection-benefits__icon" aria-hidden="true">{% render 'icon', name: 'check' %}</span><span>Full-size everyday format</span></li>
          <li><span class="collection-benefits__icon" aria-hidden="true">{% render 'icon', name: 'check' %}</span><span>Easy to keep within reach</span></li>
          <li><span class="collection-benefits__icon" aria-hidden="true">{% render 'icon', name: 'check' %}</span><span>A consistent addition to your routine</span></li>
          <li><span class="collection-benefits__icon" aria-hidden="true">{% render 'icon', name: 'check' %}</span><span>Available across multiple wellness goals</span></li>
        {%- elsif is_sachet -%}
          <li><span class="collection-benefits__icon" aria-hidden="true">{% render 'icon', name: 'check' %}</span><span>Convenient single serves</span></li>
          <li><span class="collection-benefits__icon" aria-hidden="true">{% render 'icon', name: 'check' %}</span><span>Easy to carry and store</span></li>
          <li><span class="collection-benefits__icon" aria-hidden="true">{% render 'icon', name: 'check' %}</span><span>Made for movement and travel</span></li>
          <li><span class="collection-benefits__icon" aria-hidden="true">{% render 'icon', name: 'check' %}</span><span>A simple way to try different flavours</span></li>
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <li {{ block.shopify_attributes }}>
                <span class="collection-benefits__icon" aria-hidden="true">{% render 'icon', name: 'check' %}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if is_pouch or is_sachet -%}
      <div class="discovery-bar collection-goal-bar" role="region" aria-label="Shop by goal">
        <p class="discovery-bar__prompt">Filter by wellness goal</p>
        <div class="discovery-bar__chips" role="list">
          {%- assign goals = 'Hydration|Hydration,Beauty & Collagen|Beauty,Daily Wellness|Daily Wellness,Greens|Greens,Energy|Energy,Weight Management|Weight Management,Protein|Protein' | split: ',' -%}
          {%- for g in goals -%}
            {%- assign parts = g | split: '|' -%}
            <a class="filter-chip" role="listitem" href="{{ col.url }}?filter.p.m.custom.goal={{ parts[1] | url_encode }}">{{ parts[0] }}</a>
          {%- endfor -%}
          <a class="filter-chip" href="{{ col.url }}">Clear all</a>
        </div>
      </div>
    {%- endif -%}

    <div class="section-head" id="CollectionGrid" style="scroll-margin-top:6rem">
      <h2 class="h3">
        {%- if section.settings.grid_heading != blank -%}
          {{ section.settings.grid_heading }}
        {%- elsif is_all -%}
          Find your everyday essentials
        {%- elsif is_pouch -%}
          Find your pouch
        {%- elsif is_sachet -%}
          Find your sachet
        {%- else -%}
          {{ col.title }}
        {%- endif -%}
      </h2>
      <p class="lede" style="margin-top:.5rem;max-width:40rem">
        {%- if section.settings.grid_body != blank -%}
          {{ section.settings.grid_body }}
        {%- elsif is_all -%}
          Choose the goal, flavour and format that fit naturally into your routine.
        {%- elsif is_pouch -%}
          Start with your goal, then choose the flavour you will look forward to.
        {%- elsif is_sachet -%}
          Choose the support and flavour that fit the way you move through your day.
        {%- endif -%}
      </p>
    </div>

    <div class="collection-layout">
      <aside class="facets-desktop" aria-label="{{ 'products.facets.filter_and_sort' | t }}">
        <p class="facets-desktop__title">{{ 'products.facets.filter_and_sort' | t }}</p>
        {% render 'facets', results: col, sort_by: sort_by, mobile: false %}
      </aside>

      <div class="collection-layout__main">
        <div class="facets-bar">
          <button
            type="button"
            class="btn btn--secondary facets-bar__toggle"
            data-drawer-open="FacetsDrawer"
            aria-controls="FacetsDrawer"
          >
            <span class="facets-bar__toggle-icon" aria-hidden="true">{% render 'icon', name: 'menu' %}</span>
            {{ 'products.facets.filter_and_sort' | t }}
          </button>
          <span class="text-muted">{{ 'products.facets.results' | t: count: col.products_count }}</span>
          <form method="get" class="facets-bar__sort" action="{{ col.url }}">
            {%- for f in col.filters -%}
              {%- for v in f.active_values -%}
                <input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">
              {%- endfor -%}
            {%- endfor -%}
            <label class="visually-hidden" for="SortBy">{{ 'products.facets.sort_by' | t }}</label>
            <select class="select" id="SortBy" name="sort_by" onchange="this.form.submit()">
              {%- for option in col.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </form>
        </div>

        {%- assign has_active = false -%}
        {%- for f in col.filters -%}{%- if f.active_values.size > 0 -%}{%- assign has_active = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_active -%}
          <div class="active-filters">
            {%- for f in col.filters -%}
              {%- for v in f.active_values -%}
                <a class="filter-chip" href="{{ v.url_to_remove }}">{{ f.label }}: {{ v.label }} {% render 'icon', name: 'close' %}</a>
              {%- endfor -%}
            {%- endfor -%}
            <a class="filter-chip" href="{{ col.url }}">{{ 'products.facets.clear_all' | t }}</a>
          </div>
        {%- endif -%}

        {%- if col.products.size > 0 -%}
          {%- paginate col.products by 24 -%}
            <div class="grid cols-3" role="list">
              {%- for product in col.products -%}
                <div role="listitem">{% render 'product-card', product: product %}</div>
              {%- endfor -%}
            </div>
            {% render 'pagination', paginate: paginate %}
          {%- endpaginate -%}
        {%- else -%}
          <div class="text-center section">
            <p class="h3">{{ 'products.facets.no_results' | t }}</p>
            <p class="text-muted" style="margin-top:.75rem;max-width:36rem;margin-inline:auto">If you just imported products, make sure they are set to <strong>Active</strong> (not Draft) and that this collection’s conditions or product list includes them.</p>
            <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}" style="margin-top:1rem">View all products</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if is_all or section.settings.show_quiz_strip -%}
<section class="section bg-sage">
  <div class="wrap wrap--narrow text-center">
    <h2 class="h3">Need a clearer starting point?</h2>
    <p class="lede" style="margin-top:.75rem">Answer a few quick questions and discover the REÚ products that best match your goals, taste and lifestyle.</p>
    <div style="margin-top:1.25rem">
      <a class="btn" href="{{ pages['find-your-reu'].url | default: pages.quiz.url | default: '/pages/find-your-reu' }}">Take the 60-Second Quiz <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
    </div>
  </div>
</section>
{%- elsif is_pouch -%}
<section class="section bg-cream">
  <div class="wrap wrap--narrow text-center">
    <h2 class="h3">Prefer wellness on the move?</h2>
    <p class="lede" style="margin-top:.75rem">Discover single-serve sachets designed for work, travel, workouts and busy days.</p>
    <div style="margin-top:1.25rem">
      <a class="btn" href="{{ collections.sachets.url | default: collections['sachet-collection'].url | default: '/collections/sachets' }}">Shop Sachets <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
    </div>
  </div>
</section>
{%- elsif is_sachet -%}
<section class="section bg-cream">
  <div class="wrap wrap--narrow text-center">
    <h2 class="h3">Building a daily home ritual?</h2>
    <p class="lede" style="margin-top:.75rem">Keep your favourite formula ready with a full-size REÚ pouch.</p>
    <div style="margin-top:1.25rem">
      <a class="btn" href="{{ collections.pouches.url | default: collections['pouch-collection'].url | default: '/collections/pouches' }}">Shop Pouches <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
    </div>
  </div>
</section>
{%- endif -%}

<div id="FacetsDrawer" class="drawer drawer--right" data-drawer hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'products.facets.filter_and_sort' | t }}">
  <div class="drawer__overlay" data-drawer-overlay></div>
  <div class="drawer__panel">
    <div class="drawer__header">
      <span class="drawer__title">{{ 'products.facets.filter_and_sort' | t }}</span>
      <button type="button" class="header-icon" data-drawer-close="FacetsDrawer" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body">
      {% render 'facets', results: col, sort_by: sort_by, mobile: true %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Hero eyebrow" },
    { "type": "text", "id": "heading", "label": "Hero heading" },
    { "type": "textarea", "id": "body", "label": "Hero body" },
    { "type": "text", "id": "grid_heading", "label": "Grid heading" },
    { "type": "textarea", "id": "grid_body", "label": "Grid supporting copy" },
    { "type": "checkbox", "id": "show_discovery", "label": "Show discovery goal bar", "default": false },
    { "type": "text", "id": "discovery_prompt", "label": "Discovery prompt", "default": "What would you like to support today?" },
    { "type": "checkbox", "id": "show_benefits", "label": "Show benefit strip", "default": false },
    { "type": "checkbox", "id": "show_quiz_strip", "label": "Show quiz support strip", "default": false }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Full-size everyday format" }
    ]}
  ]
}
{% endschema %}
