{%- liquid
  assign reverse = false
  if section.settings.layout == 'right'
    assign reverse = true
  endif
-%}
<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="iwt{% if reverse %} iwt--reverse{% endif %}">
      <div class="iwt__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '600,900,1400', sizes: '(min-width:900px) 45vw, 100vw', loading: 'lazy', alt: section.settings.heading | escape }}
        {%- elsif section.settings.fallback_asset != blank -%}
          <img src="{{ section.settings.fallback_asset | asset_url }}" width="1800" height="2250" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | newline_to_br }}</h2>
        {%- if section.settings.body != blank -%}<div class="lede rte" style="margin-top:1rem">{{ section.settings.body }}</div>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div style="margin-top:1.5rem">
            <a class="btn" href="{{ section.settings.cta_link | default: routes.root_url }}">{{ section.settings.cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Image position", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More than supplements" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A ritual that\nfeels like you." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>REÚ brings intention to everyday wellness with products that feel considered, modern, and easy to make your own.</p><p>No complicated routines. No unnecessary pressure. Just simple support for showing up as your best self, one day at a time.</p>" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Our Story" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-blush", "label": "Blush" }
    ], "default": "" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
