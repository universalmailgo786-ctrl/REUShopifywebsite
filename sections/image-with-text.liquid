{%- liquid
  assign s = section.settings
  assign reverse = ''
  if s.layout == 'right'
    assign reverse = 'direction:rtl'
  endif
-%}
<section class="section {{ s.bg_scheme }}">
  <div class="wrap">
    <div class="grid cols-2-1" style="align-items:center;{{ reverse }}">
      <div class="media-ratio" style="direction:ltr;border-radius:var(--radius-lg);overflow:hidden;aspect-ratio:{{ s.ratio }}">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: widths: '500,700,900,1200', sizes: '(min-width:750px) 50vw, 100vw', loading: 'lazy', alt: s.image.alt | default: s.heading | escape }}
        {%- elsif s.fallback_asset != blank -%}
          <img src="{{ s.fallback_asset | asset_url }}" width="1800" height="1200" alt="{{ s.heading | escape }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div style="direction:ltr">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ s.heading }}</h2>
        {%- if s.body != blank -%}<div class="lede rte" style="margin-top:1rem">{{ s.body }}</div>{%- endif -%}
        {%- if s.cta_label != blank -%}<div style="margin-top:1.5rem"><a class="btn btn--secondary" href="{{ s.cta_link | default: '#' }}">{{ s.cta_label }}</a></div>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Image position", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "select", "id": "ratio", "label": "Image ratio", "options": [
      { "value": "4/5", "label": "Portrait" }, { "value": "1/1", "label": "Square" }, { "value": "4/3", "label": "Landscape" }
    ], "default": "4/5" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More than supplements" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A ritual that feels like you" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>REÚ brings intention to everyday wellness with products that feel considered, modern, and easy to make your own.</p>" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Our Story" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename", "info": "Theme asset used when no image is chosen (e.g. reu-collagen-mixed-berry.jpg)." },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-blush", "label": "Blush" }, { "value": "bg-lilac", "label": "Lilac" }
    ], "default": "" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
