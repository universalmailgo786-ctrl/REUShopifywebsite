<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="h2">{{ section.settings.heading }}</h1>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    <div class="grid cols-2">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_card' -%}
          {%- assign col = collections[block.settings.collection] -%}
          <div class="format-card" {{ block.shopify_attributes }}>
            <a class="format-card__media" href="{{ col.url | default: block.settings.link | default: '#' }}" aria-hidden="true" tabindex="-1">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width:750px) 45vw, 100vw', loading: 'lazy', alt: block.settings.title | escape }}
              {%- elsif block.settings.fallback_asset != blank -%}
                <img src="{{ block.settings.fallback_asset | asset_url }}" width="1800" height="1200" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- elsif col.featured_image -%}
                {{ col.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: col.title | escape }}
              {%- endif -%}
            </a>
            <div class="format-card__body">
              <h2 class="h3">{{ block.settings.title | default: col.title }}</h2>
              <p class="text-muted">{{ block.settings.text }}</p>
              <div style="margin-top:auto;padding-top:.75rem"><a class="btn" href="{{ col.url | default: block.settings.link | default: '#' }}">{{ block.settings.cta }}</a></div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.goals_heading != blank -%}
      <div class="section-head section-head--center" style="margin-top:var(--space-xl)">
        <h2 class="h3">{{ section.settings.goals_heading }}</h2>
      </div>
      <div class="snap-row">
        {%- for block in section.blocks -%}
          {%- if block.type == 'goal_link' -%}
            <a class="filter-chip" style="justify-content:center;padding:.9rem 1.4rem" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Collections hub",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your format" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Build an at-home ritual with full-size pouches, keep wellness within reach with single-serve sachets, or mix both formats around your day." },
    { "type": "text", "id": "goals_heading", "label": "Shop by goal heading", "default": "Or shop by goal" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }
    ], "default": "" }
  ],
  "blocks": [
    { "type": "collection_card", "name": "Collection card", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename" },
      { "type": "text", "id": "title", "label": "Title", "default": "Pouch Collection" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Full-size favourites for your everyday routine." },
      { "type": "text", "id": "cta", "label": "CTA", "default": "Shop Pouches" },
      { "type": "url", "id": "link", "label": "Fallback link" }
    ]},
    { "type": "goal_link", "name": "Goal link", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Hydration" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{
    "name": "Collections hub",
    "blocks": [
      { "type": "collection_card", "settings": { "fallback_asset": "reu-format-pouch.jpg", "title": "Pouch Collection", "text": "Full-size favourites for your everyday routine.", "cta": "Shop Pouches" } },
      { "type": "collection_card", "settings": { "fallback_asset": "reu-format-sachet.jpg", "title": "Sachet Collection", "text": "Convenient single serves for movement, travel, and busy days.", "cta": "Shop Sachets" } },
      { "type": "goal_link", "settings": { "title": "Hydration" } },
      { "type": "goal_link", "settings": { "title": "Beauty & Collagen" } },
      { "type": "goal_link", "settings": { "title": "Daily Wellness" } },
      { "type": "goal_link", "settings": { "title": "Greens & Nutrition" } },
      { "type": "goal_link", "settings": { "title": "Energy & Performance" } },
      { "type": "goal_link", "settings": { "title": "Weight Management" } },
      { "type": "goal_link", "settings": { "title": "Protein & Recovery" } }
    ]
  }]
}
{% endschema %}
