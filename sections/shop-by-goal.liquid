<section class="section bg-green">
  <div class="wrap">
    <div class="section-head section-head--center" style="max-width:42rem">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | newline_to_br }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin:1rem auto 0">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    <div class="snap-row">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- assign href = block.settings.link -%}
        {%- if href == blank and col != blank -%}{%- assign href = col.url -%}{%- endif -%}
        <a class="goal-card" href="{{ href | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '(min-width:990px) 16vw, 80vw', loading: 'lazy', alt: block.settings.title | escape }}
          {%- elsif block.settings.fallback_asset != blank -%}
            <img src="{{ block.settings.fallback_asset | asset_url }}" width="1800" height="1200" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- elsif col.featured_image -%}
            {{ col.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div>
            <h3 class="h4">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            <span class="link-arrow">{{ block.settings.cta | default: 'Shop' }} {% render 'icon', name: 'arrow' %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shop by goal",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by goal" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Start with what\nyou want to feel." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Your routine should begin with your goals—not a crowded shelf. Choose the support that matters most to you today." }
  ],
  "blocks": [
    { "type": "goal", "name": "Goal", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename" },
      { "type": "text", "id": "title", "label": "Title", "default": "Hydration" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Refresh your routine and replenish with ease." },
      { "type": "text", "id": "cta", "label": "CTA", "default": "Shop Hydration" },
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "url", "id": "link", "label": "Fallback link" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "Shop by goal",
    "blocks": [
      { "type": "goal", "settings": { "fallback_asset": "reu-hydration-lemon-lime.jpg", "title": "Hydration", "text": "Refresh your routine and replenish with ease.", "cta": "Shop Hydration" } },
      { "type": "goal", "settings": { "fallback_asset": "reu-collagen-mixed-berry.jpg", "title": "Beauty & Collagen", "text": "Daily collagen support for a ritual you will look forward to.", "cta": "Shop Beauty" } },
      { "type": "goal", "settings": { "fallback_asset": "reu-daily-wellness-peach-mango.jpg", "title": "Daily Wellness", "text": "Simple everyday support for feeling your best.", "cta": "Shop Wellness" } },
      { "type": "goal", "settings": { "fallback_asset": "reu-greens-pineapple.jpg", "title": "Greens & Nutrition", "text": "A bright, convenient way to add greens to your day.", "cta": "Shop Greens" } },
      { "type": "goal", "settings": { "fallback_asset": "reu-protein-chocolate.jpg", "title": "Energy & Performance", "text": "Fuel movement, energy, and recovery.", "cta": "Shop Performance" } },
      { "type": "goal", "settings": { "fallback_asset": "reu-weight-pink-lemonade.jpg", "title": "Weight Management", "text": "Build a more intentional daily routine.", "cta": "Shop Support" } }
    ]
  }]
}
{% endschema %}
