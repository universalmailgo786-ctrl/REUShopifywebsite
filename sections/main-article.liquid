<article class="section">
  <div class="wrap wrap--narrow">
    {% render 'breadcrumbs' %}
    <header style="margin-bottom:var(--space-lg)">
      {%- if article.tags.size > 0 -%}<span class="badge">{{ article.tags.first }}</span>{%- endif -%}
      <h1 class="h1" style="margin:.5rem 0">{{ article.title }}</h1>
      <p class="text-muted">
        {%- if section.settings.show_author -%}{{ 'blogs.article.by' | t }} {{ article.author }} · {% endif -%}
        {%- if section.settings.show_date -%}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time>{%- endif -%}
      </p>
    </header>

    {%- if article.image -%}
      <div class="media-ratio" style="aspect-ratio:16/9;border-radius:var(--radius-lg);overflow:hidden;margin-bottom:var(--space-lg)">
        {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600,900,1200,1400', sizes: '(min-width:820px) 820px, 100vw', alt: article.image.alt | default: article.title | escape }}
      </div>
    {%- endif -%}

    <div class="rte">{{ article.content }}</div>

    <div class="notice" style="margin-top:var(--space-lg)">{{ 'blogs.article.disclaimer' | t }}</div>

    {%- if blog.comments_enabled? -%}{%- endif -%}

    <div style="margin-top:var(--space-lg)"><a class="link-arrow" href="{{ blog.url }}">{% render 'icon', name: 'arrow-left' %} {{ 'blogs.article.back' | t }}</a></div>
  </div>

  {%- comment -%} Related articles {%- endcomment -%}
  <div class="wrap section">
    <h2 class="h3" style="margin-bottom:var(--space-md)">{{ 'blogs.article.related' | t }}</h2>
    <div class="snap-row">
      {%- assign count = 0 -%}
      {%- for a in blog.articles -%}
        {%- if a.id != article.id and count < 3 -%}
          {%- assign count = count | plus: 1 -%}
          <article class="card">
            <a class="card__media" href="{{ a.url }}" tabindex="-1">{%- if a.image -%}{{ a.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: a.title | escape }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</a>
            <div class="card__body"><h3 class="h4"><a href="{{ a.url }}">{{ a.title }}</a></h3></div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "author": { "@type": "Organization", "name": {{ shop.name | json }} },
  {% if article.image %}"image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
  "mainEntityOfPage": {{ shop.url | append: article.url | json }}
}
</script>
{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true }
  ]
}
{% endschema %}
