<section class="section--tight {{ section.settings.bg_scheme }}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <p class="eyebrow text-center">{{ section.settings.heading }}</p>
    {%- endif -%}
    <div class="grid cols-4 feature-row" style="margin-top:1rem">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <span class="icon-circle">{% render 'icon', name: block.settings.icon %}</span>
          <p style="font-weight:500">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Eyebrow", "default": "Made for real life" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-blush", "label": "Blush" }
    ], "default": "bg-cream" }
  ],
  "blocks": [
    { "type": "item", "name": "Benefit", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" },
        { "value": "shield", "label": "Shield" }, { "value": "drop", "label": "Drop" }, { "value": "check", "label": "Check" }
      ], "default": "leaf" },
      { "type": "text", "id": "text", "label": "Text", "default": "Thoughtfully selected ingredients" }
    ]}
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Trust strip",
    "blocks": [
      { "type": "item", "settings": { "icon": "leaf", "text": "Thoughtfully selected ingredients" } },
      { "type": "item", "settings": { "icon": "sparkle", "text": "Great-tasting daily formats" } },
      { "type": "item", "settings": { "icon": "heart", "text": "Designed for women" } },
      { "type": "item", "settings": { "icon": "check", "text": "Clear, honest guidance" } }
    ]
  }]
}
{% endschema %}
