{%- if section.settings.enabled -%}
<div class="announcement">
  <div class="announcement__inner">
    <span>{{ section.settings.text }}</span>
    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement", "default": true },
    { "type": "text", "id": "text", "label": "Message", "default": "Pre-orders are now open — reserve your REÚ routine today." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View Pre-Order Details" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
