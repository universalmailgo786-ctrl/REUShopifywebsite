{%- liquid
  assign secondary = section.settings.secondary
  if secondary == blank and settings.preorder_ship_window != blank
    assign secondary = 'Estimated shipping: ' | append: settings.preorder_ship_window
  endif
-%}
{%- if section.settings.enabled -%}
<div class="announcement" style="{% if section.settings.bg != blank %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.color != blank %}color:{{ section.settings.color }};{% endif %}">
  <div class="announcement__inner wrap">
    <span>{{ section.settings.text }}</span>
    {%- if secondary != blank -%}<span class="announcement__sep" aria-hidden="true">·</span><span>{{ secondary }}</span>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "text", "label": "Text", "default": "Pre-Orders Are Now Open — Reserve Your REÚ Routine" },
    { "type": "text", "id": "secondary", "label": "Secondary text", "info": "Optional. Leave blank to use Theme Settings → Pre-order ship window when set." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View Pre-Order Details" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "bg", "label": "Background" },
    { "type": "color", "id": "color", "label": "Text color" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
