<section class="values-grid section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="values-grid__list">
      {%- for block in section.blocks -%}
        <article class="values-grid__card" {{ block.shopify_attributes }}>
          <h3 class="values-grid__title">{{ block.settings.title }}</h3>
          <p class="values-grid__text">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <div class="text-center" style="margin-top:var(--space-lg)"><a class="btn" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Values grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our values" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we stand for" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-lilac", "label": "Lilac" }
    ], "default": "bg-cream" }
  ],
  "blocks": [
    { "type": "value", "name": "Value", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Quality" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "We choose products and partners with care and publish only verified product information." }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "Values grid",
    "blocks": [
      { "type": "value", "settings": { "title": "Quality", "text": "We choose products and partners with care and publish only verified product information." } },
      { "type": "value", "settings": { "title": "Transparency", "text": "We make ingredients, directions, policies, and expectations easy to understand." } },
      { "type": "value", "settings": { "title": "Innovation", "text": "We look for smarter, more enjoyable ways to support modern routines." } },
      { "type": "value", "settings": { "title": "Simplicity", "text": "We remove unnecessary friction from choosing, using, and reordering wellness products." } },
      { "type": "value", "settings": { "title": "Empowerment", "text": "We offer guidance that supports women’s choices without pressure or unrealistic promises." } },
      { "type": "value", "settings": { "title": "Confidence", "text": "We provide clear, thoughtful guidance so women can choose and enjoy their wellness routines with confidence." } }
    ]
  }]
}
{% endschema %}
