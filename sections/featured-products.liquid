{%- liquid
  comment
    Resolve products in this order:
    1) Explicit product list from theme editor
    2) Selected collection
    3) Hardcoded REÚ catalogue handles (all_products)
    4) collections.all
  endcomment

  assign products = section.settings.products | where: 'title'
  if products.size == 0 and section.settings.collection != blank
    assign products = section.settings.collection.products
  endif

  if products.size == 0
    assign fallback_handles = 'collagen-mixed-berry,hydration-electrolytes-lemon-lime,hydration-electrolytes-watermelon,hydration-electrolytes-coconut,greens-pineapple,daily-wellness-peach-mango,gummies-mixed-berry,weight-management-pink-lemonade,premium-protein-chocolate' | split: ','
    assign resolved = ''
    for handle in fallback_handles
      assign p = all_products[handle]
      if p != blank and p.title != blank
        if resolved == blank
          assign resolved = p.handle
        else
          assign resolved = resolved | append: ',' | append: p.handle
        endif
      endif
    endfor
  endif
-%}
<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    {%- if products.size > 0 -%}
      <div class="snap-row">
        {%- for product in products limit: section.settings.limit -%}
          {%- if product != blank and product.title != blank -%}
            {% render 'product-card', product: product %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif resolved != blank -%}
      <div class="snap-row">
        {%- assign shown = 0 -%}
        {%- assign handles = resolved | split: ',' -%}
        {%- for handle in handles -%}
          {%- if shown >= section.settings.limit -%}{% break %}{%- endif -%}
          {%- assign product = all_products[handle] -%}
          {%- if product != blank and product.title != blank -%}
            {% render 'product-card', product: product %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif collections.all.products.size > 0 -%}
      <div class="snap-row">
        {%- for product in collections.all.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="notice" style="margin-top:1rem">
        <p><strong>No products are visible on the storefront yet.</strong></p>
        <p class="text-muted" style="margin-top:.5rem">In Shopify Admin → Products, set each product to <strong>Active</strong> (not Draft), then refresh this page. Collections only show Active products.</p>
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:1.75rem"><a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your daily essentials" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Meet the REÚ favourites designed to fit smoothly into mornings, workouts, workdays, and everything between." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Or pick products", "limit": 8 },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Max products", "default": 4 },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop All Products" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-blush", "label": "Blush" }
    ], "default": "" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
