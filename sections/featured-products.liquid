{%- liquid
  assign products = section.settings.products
  assign limit = section.settings.limit | default: 4
  if products == blank or products.size == 0
    if section.settings.collection != blank
      assign products = section.settings.collection.products
    else
      assign products = collections.all.products
    endif
  endif
  assign visible_count = 0
  if products != blank
    assign visible_count = products.size
  endif
-%}
<section class="section bg-sage">
  <div class="wrap">
    <div class="section-head section-head--row">
      <div class="section-head__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
      {%- endif -%}
    </div>
    {%- if visible_count > 0 -%}
      <div class="featured-grid">
        {%- for product in products limit: limit -%}
          {%- if product != blank and product.title != blank -%}
            {% render 'product-card', product: product %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="notice">
        <p><strong>No products are available to the Online Store yet.</strong></p>
        <p class="text-muted" style="margin-top:.5rem">Publish products to the Online Store channel, or select products/collection in this section.</p>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop REÚ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your daily essentials." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Meet the REÚ favourites designed to fit smoothly into mornings, workouts, workdays, and everything between." },
    { "type": "collection", "id": "collection", "label": "Collection to feature" },
    { "type": "product_list", "id": "products", "label": "Or pick specific products", "limit": 8 },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Max products", "default": 4 },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop All Products" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
