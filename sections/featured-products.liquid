{%- comment -%}
  Featured products — resolve from theme settings first, then the full Online Store catalogue.
  If this section is empty while products look Active in admin, they are usually not published
  to the Online Store sales channel.
{%- endcomment -%}

{%- liquid
  assign products = section.settings.products
  assign limit = section.settings.limit | default: 4

  if products == blank or products.size == 0
    if section.settings.collection != blank
      assign products = section.settings.collection.products
    endif
  endif

  if products == blank or products.size == 0
    assign products = collections.all.products
  endif

  assign visible_count = 0
  if products != blank
    assign visible_count = products.size
  endif
  assign catalogue_count = collections.all.products_count | default: 0
-%}

<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    {%- if visible_count > 0 -%}
      <div class="snap-row">
        {%- for product in products limit: limit -%}
          {%- if product != blank and product.title != blank -%}
            {% render 'product-card', product: product %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="notice" style="margin-top:1rem">
        <p><strong>No products are available to the Online Store yet.</strong></p>
        <p class="text-muted" style="margin-top:.5rem">
          Active status is not enough. Open each product → <strong>Publishing</strong> → enable
          <strong>Online Store</strong>, then save. Or in the theme editor, open this Featured section and
          pick a collection / products manually.
        </p>
        {%- if request.design_mode -%}
          <p class="text-muted" style="margin-top:.75rem">
            Debug: Online Store catalogue count = {{ catalogue_count }}.
            If this is 0, products are not published to Online Store.
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:1.75rem">
        <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your daily essentials" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Meet the REÚ favourites designed to fit smoothly into mornings, workouts, workdays, and everything between." },
    { "type": "collection", "id": "collection", "label": "Collection to feature", "info": "Leave blank to use all Online Store products." },
    { "type": "product_list", "id": "products", "label": "Or pick specific products", "limit": 8 },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Max products", "default": 4 },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop All Products" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-blush", "label": "Blush" }
    ], "default": "" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
