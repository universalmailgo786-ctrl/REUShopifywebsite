{%- liquid
  assign products = section.settings.products
  assign limit = section.settings.limit | default: 4
  if products == blank or products.size == 0
    if section.settings.collection != blank
      assign products = section.settings.collection.products
    else
      assign products = collections.all.products
    endif
  endif
  assign visible_count = 0
  if products != blank
    assign visible_count = products.size
  endif
-%}
<section
  class="shop-reu section"
  data-shop-reu
  aria-labelledby="ShopReuHeading-{{ section.id }}"
>
  <div class="wrap">
    <div class="shop-reu__head">
      <div class="shop-reu__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="shop-reu__eyebrow">
            <span class="shop-reu__sparkle" aria-hidden="true">{% render 'icon', name: 'sparkle' %}</span>
            <span>{{ section.settings.eyebrow }}</span>
          </p>
        {%- endif -%}
        <h2 class="shop-reu__heading" id="ShopReuHeading-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.body != blank -%}
          <p class="shop-reu__body">{{ section.settings.body }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <a
          class="btn shop-reu__cta"
          href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
        >
          <span>{{ section.settings.cta_label }}</span>
          <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span>
        </a>
      {%- endif -%}
    </div>

    {%- if visible_count > 0 -%}
      <div class="shop-reu__carousel">
        <div class="shop-reu__track" data-shop-reu-track tabindex="0" role="list">
          {%- for product in products limit: limit -%}
            {%- if product != blank and product.title != blank -%}
              {% render 'shop-reu-card', product: product %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="shop-reu__dots" data-shop-reu-dots aria-hidden="true"></div>
      </div>
    {%- else -%}
      <div class="notice">
        <p><strong>No products are available to the Online Store yet.</strong></p>
        <p class="text-muted" style="margin-top:.5rem">Publish products to the Online Store channel, or select products/collection in this section.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "section-shop-reu",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop REÚ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your daily essentials."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Meet the REÚ favourites designed to fit smoothly into mornings, workouts, workdays, and everything between."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to feature"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Or pick specific products",
      "limit": 8
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Max products",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
