{%- liquid
  assign col = section.settings.collection
  assign products = col.products | default: section.settings.products
-%}
<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede" style="margin-top:.75rem">{{ section.settings.body }}</p>{%- endif -%}
    </div>
    {%- if products.size > 0 -%}
      <div class="snap-row">
        {%- for product in products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid cols-4">
        {%- for i in (1..4) -%}
          <div class="product-card"><div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-card__body"><p class="text-muted">Select a collection in the theme editor to feature products.</p></div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:1.75rem"><a class="btn" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your daily essentials" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Meet the REÚ favourites designed to fit smoothly into mornings, workouts, workdays, and everything between." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Or pick products", "limit": 8 },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Max products", "default": 4 },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop All Products" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-blush", "label": "Blush" }
    ], "default": "" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
