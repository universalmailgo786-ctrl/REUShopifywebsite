{%- comment -%}
  Product recommendations. Loads via Section Rendering API when JS is available.
  Falls back to products from the first related collection when recommendations are empty.
{%- endcomment -%}
<section
  id="shopify-section-{{ section.id }}"
  class="section {{ section.settings.bg_scheme }}"
  data-product-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
>
  <div class="wrap" data-recommendations-body>
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="section-head">
        <h2 class="h3">{{ section.settings.heading }}</h2>
      </div>
      <div class="snap-row">
        {%- for product in recommendations.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- elsif product.collections.size > 0 -%}
      {%- assign related_collection = product.collections.first -%}
      {%- if related_collection.products_count > 1 -%}
        <div class="section-head">
          <h2 class="h3">{{ section.settings.heading }}</h2>
        </div>
        <div class="snap-row">
          {%- assign shown = 0 -%}
          {%- for related in related_collection.products -%}
            {%- if related.id == product.id -%}{% continue %}{%- endif -%}
            {%- if shown >= section.settings.limit -%}{% break %}{%- endif -%}
            {% render 'product-card', product: related %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-product-recommendations][data-url]');
    if (!root || !root.getAttribute('data-url')) return;
    if (root.querySelector('.product-card')) return;
    fetch(root.getAttribute('data-url'))
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var next = doc.querySelector('[data-recommendations-body]');
        var current = root.querySelector('[data-recommendations-body]');
        if (next && current && next.innerHTML.trim()) current.innerHTML = next.innerHTML;
      })
      .catch(function () {});
  })();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }
    ], "default": "bg-cream" }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
