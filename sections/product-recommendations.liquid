{%- liquid
  assign rec = recommendations
-%}
{%- if rec.performed and rec.products_count > 0 -%}
<section class="section {{ section.settings.bg_scheme }}">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h3">{{ section.settings.heading }}</h2>
    </div>
    <div class="snap-row">
      {%- for product in rec.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 },
    { "type": "select", "id": "bg_scheme", "label": "Background", "options": [
      { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }
    ], "default": "bg-cream" }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
