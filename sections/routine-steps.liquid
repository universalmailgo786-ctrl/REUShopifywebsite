<section class="routine">
  <div class="routine__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '900,1400,2000,2400', sizes: '100vw', loading: 'lazy', alt: '' }}
    {%- else -%}
      <img src="{{ 'reu-daily-wellness-peach-mango.jpg' | asset_url }}" width="2000" height="1333" alt="" loading="lazy">
    {%- endif -%}
  </div>
  <div class="routine__overlay" aria-hidden="true"></div>
  <div class="wrap routine__inner">
    <div class="section-head section-head--center" style="max-width:40rem;margin-inline:auto">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2" style="color:#fff">{{ section.settings.heading | newline_to_br }}</h2>
    </div>
    <div class="routine__steps">
      {%- for block in section.blocks -%}
        <article class="routine-step" {{ block.shopify_attributes }}>
          <div class="routine-step__num">{{ block.settings.number }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:2rem;text-align:center">
        <a class="btn btn--on-dark" href="{{ section.settings.cta_link | default: routes.root_url }}">{{ section.settings.cta_label }} <span class="btn__arrow">{% render 'icon', name: 'arrow' %}</span></a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Routine steps",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your routine" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A simple routine made\nfor real life." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Find My Routine" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "01" },
      { "type": "text", "id": "title", "label": "Title", "default": "Choose Your Goal" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Begin with the area of wellness that matters most to you." }
    ]}
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Routine steps",
    "blocks": [
      { "type": "step", "settings": { "number": "01", "title": "Choose Your Goal", "text": "Begin with the area of wellness that matters most to you." } },
      { "type": "step", "settings": { "number": "02", "title": "Find Your Formula", "text": "Explore hydration, collagen, greens, daily wellness, protein, and more." } },
      { "type": "step", "settings": { "number": "03", "title": "Choose Your Format", "text": "Keep a pouch at home or take convenient sachets wherever you go." } },
      { "type": "step", "settings": { "number": "04", "title": "Make It Yours", "text": "Follow the product directions and build a ritual that fits your day." } }
    ]
  }]
}
{% endschema %}
