{%- liquid
  assign has_video = false
  if section.settings.video != blank
    assign has_video = true
  endif
  assign has_copy = false
  if section.settings.heading != blank or section.settings.body != blank
    assign has_copy = true
  endif
-%}
<section class="media-banner{% unless has_copy %} media-banner--image-only{% endunless %}" data-media-banner>
  <div class="media-banner__media" aria-hidden="true">
    {%- if has_video -%}
      {{ section.settings.video | video_tag: image_size: '2400x', autoplay: false, loop: true, muted: true, controls: false, class: 'media-banner__video', preload: 'none' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '900,1400,2000,2400', sizes: '100vw', loading: 'lazy', alt: '' }}
    {%- else -%}
      <img
        src="{{ 'reu-media-banner.jpg' | asset_url }}"
        width="1913"
        height="822"
        alt=""
        loading="lazy"
        decoding="async"
      >
    {%- endif -%}
  </div>
  {%- if has_copy -%}
    <div class="media-banner__overlay"></div>
    <div class="media-banner__content">
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  {%- if has_video -%}
    <div class="media-banner__controls">
      <button type="button" data-media-play aria-pressed="false" aria-label="Play video">
        <span data-media-play-icon>{% render 'icon', name: 'play' %}</span>
        <span data-media-pause-icon hidden>{% render 'icon', name: 'pause' %}</span>
      </button>
    </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Media banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image / poster" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wellness that moves with you." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Simple rituals. Thoughtful products. A routine that feels entirely your own." }
  ],
  "presets": [{ "name": "Media banner" }]
}
{% endschema %}
