<section class="section bg-cream">
  <div class="wrap">
    <div class="section-head">
      <h1 class="h2">{{ section.settings.heading | default: 'Collections' }}</h1>
    </div>
    <div class="grid cols-3">
      {%- for col in collections -%}
        {%- unless col.handle == 'frontpage' -%}
          <a class="card" href="{{ col.url }}">
            <div class="card__media">
              {%- if col.featured_image -%}{{ col.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width:750px) 30vw, 90vw', alt: col.title | escape }}
              {%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </div>
            <div class="card__body"><h2 class="h4">{{ col.title }}</h2><span class="text-muted">{{ col.products_count }} products</span></div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" } ] }
{% endschema %}
