<div style="padding-block:var(--space-2xl)">
  {%- if settings.logo != blank -%}
    <img src="{{ settings.logo | image_url: width: 400 }}" width="400" height="220" alt="{{ shop.name }}" style="margin:0 auto var(--space-lg);width:160px;height:auto">
  {%- else -%}
    <h1 class="h1" style="font-family:var(--font-display)">REÚ</h1>
  {%- endif -%}

  <p class="eyebrow text-center">{{ settings.brand_tagline }}</p>
  <h1 class="h2">Something good is coming</h1>
  <p class="lede" style="margin:1rem auto 0;max-width:32rem">Join the REÚ community to be the first to know when pre-orders open.</p>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors.messages['form'] }}</p>{%- endif -%}
  {%- endform -%}

  {%- form 'customer', id: 'password-newsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, password-page">
    {%- if form.posted_successfully? -%}<p class="form-message form-message--success">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
    <div style="display:flex;gap:.5rem;max-width:26rem;margin:1.5rem auto 0">
      <label class="visually-hidden" for="pw-email">{{ 'general.newsletter.label' | t }}</label>
      <input class="input" id="pw-email" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
      <button class="btn" type="submit">{{ 'general.newsletter.button' | t }}</button>
    </div>
  {%- endform -%}

  <details style="margin-top:var(--space-xl)">
    <summary class="link-arrow" style="cursor:pointer;justify-content:center">Enter using password</summary>
    <div style="max-width:22rem;margin:1rem auto 0">
      {%- form 'storefront_password' -%}
        <div style="display:flex;gap:.5rem">
          <input class="input" type="password" name="password" placeholder="Password" aria-label="Password">
          <button class="btn" type="submit">Enter</button>
        </div>
      {%- endform -%}
    </div>
  </details>
</div>
