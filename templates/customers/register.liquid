<section class="section">
  <div class="wrap wrap--narrow">
    <h1 class="h2" style="margin-bottom:var(--space-lg)">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <div class="grid cols-2" style="gap:1rem">
        <label class="field"><span>{{ 'customer.register.first_name' | t }}</span><input class="input" type="text" name="customer[first_name]" autocomplete="given-name"></label>
        <label class="field"><span>{{ 'customer.register.last_name' | t }}</span><input class="input" type="text" name="customer[last_name]" autocomplete="family-name"></label>
      </div>
      <label class="field"><span>{{ 'customer.register.email' | t }}</span><input class="input" type="email" name="customer[email]" required autocomplete="email"></label>
      <label class="field"><span>{{ 'customer.register.password' | t }}</span><input class="input" type="password" name="customer[password]" autocomplete="new-password"></label>
      <button class="btn" type="submit">{{ 'customer.register.submit' | t }}</button>
      <a class="link-arrow" style="margin-left:1rem" href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
    {%- endform -%}
  </div>
</section>
