<section class="section">
  <div class="wrap">
    <div class="facets-bar">
      <h1 class="h2">{{ 'customer.account.title' | t }}</h1>
      <a class="btn btn--secondary" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
    </div>

    <h2 class="h3" style="margin:var(--space-lg) 0 var(--space-sm)">{{ 'customer.account.orders' | t }}</h2>
    {%- paginate customer.orders by 12 -%}
      {%- if customer.orders.size > 0 -%}
        <div style="overflow-x:auto">
          <table style="width:100%;border-collapse:collapse;min-width:520px">
            <thead><tr>
              <th style="text-align:left;padding:.6rem;border-bottom:var(--border)">{{ 'customer.orders.order' | t }}</th>
              <th style="text-align:left;padding:.6rem;border-bottom:var(--border)">{{ 'customer.orders.date' | t }}</th>
              <th style="text-align:left;padding:.6rem;border-bottom:var(--border)">{{ 'customer.orders.status' | t }}</th>
              <th style="text-align:right;padding:.6rem;border-bottom:var(--border)">{{ 'customer.orders.total' | t }}</th>
            </tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td style="padding:.6rem;border-bottom:var(--border)"><a class="link-arrow" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td style="padding:.6rem;border-bottom:var(--border)">{{ order.created_at | date: '%b %-d, %Y' }}</td>
                  <td style="padding:.6rem;border-bottom:var(--border)">{{ order.fulfillment_status_label }}</td>
                  <td style="padding:.6rem;border-bottom:var(--border);text-align:right">{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="text-muted">{{ 'customer.account.no_orders' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}

    <p style="margin-top:var(--space-lg)"><a class="link-arrow" href="{{ routes.account_addresses_url }}">{{ 'customer.account.details' | t }} {% render 'icon', name: 'arrow' %}</a></p>
  </div>
</section>
