<section class="section">
  <div class="wrap wrap--narrow">
    <h1 class="h2" style="margin-bottom:var(--space-lg)">{{ 'customer.recover.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span>New password</span><input class="input" type="password" name="customer[password]" autocomplete="new-password"></label>
      <label class="field"><span>Confirm password</span><input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password"></label>
      <button class="btn" type="submit">Reset password</button>
    {%- endform -%}
  </div>
</section>
